:root {
  --radius: 8px;
  --h-control: 32px;
  --h-control-nested: 22px;
  --icon: 20px;
  --pad-sm: 8px;
  --pad-md: 12px;
  --pad-lg: 16px;
  --pad-xl: 24px;
  --gap-xs: 8px;
  --gap-sm: 12px;
  --gap-md: 16px;
  --gap-lg: 28px;
  --gap-xl: 40px;
