        c.beginPath(); c.moveTo(b.w, b.h - ear); c.lineTo(b.w - ear, b.h); c.lineTo(b.w - ear * .9, b.h - ear * .9); c.closePath(); c.fill();
        // a faint band along the top where the glue strip sits
        c.fillStyle = 'rgba(0,0,0,.05)'; c.fillRect(0, 0, b.w, Math.min(14, b.h * .16));
        if(lbl){
          const ib = innerBox(e), f = fitText(c, lbl, Math.max(12, ib.w), Math.max(12, ib.h), STICKY_FONT);
          c.beginPath(); c.rect(6, 6, b.w - 12, b.h - 12); c.clip();
          c.font = handFont(f.px); c.fillStyle = paper.ink; c.textBaseline = 'top';
          f.lines.forEach((l, i) => c.fillText(l, STICKY_PAD, STICKY_PAD - 2 + i * f.px * 1.35));
        }
        c.restore();
        break;
      }
      case 'image': {
        const b = normRect(e), img = imageFor(e);
        c.setLineDash([]);
        if(img && img.complete && img.naturalWidth){ c.drawImage(img, b.x, b.y, b.w, b.h); }
        else {
          // not here yet (arrives with the next publish) or unreadable: a hatched placeholder
          c.save(); c.globalAlpha = .5; c.strokeStyle = C.muted; c.lineWidth = 1.2; c.strokeRect(b.x, b.y, b.w, b.h);
          c.beginPath(); c.moveTo(b.x, b.y); c.lineTo(b.x + b.w, b.y + b.h); c.moveTo(b.x + b.w, b.y); c.lineTo(b.x, b.y + b.h); c.stroke();
          c.globalAlpha = 1; drawMultiline(c, e.src ? 'image' : 'image on its way', b.x + b.w / 2, b.y + b.h / 2, 13, C.muted);
          c.restore();
        }
        if(byClaude(e)){ c.strokeStyle = C.claude; c.lineWidth = 2; c.strokeRect(b.x, b.y, b.w, b.h); }
        break;
      }
      case 'text': {
        const px = textPx(e);
        {
          const live = e === editing ? editor.value : (e.text || '');
          c.save(); c.font = handFont(px); c.fillStyle = ink; c.textBaseline = 'top';
          live.split('\n').forEach((l, i) => c.fillText(l, e.x + 4, e.y + 4 + i * px * 1.35));
          c.restore();
        }
        break;
      }
      case 'line': {
        skLine(c, r, e.x1, e.y1, e.x2, e.y2);
        break;
      }
      case 'arrow': {
        const {p1, p2} = arrowEndpoints(e);
        skLine(c, r, p1.x, p1.y, p2.x, p2.y);
        c.setLineDash([]);
        const ang = Math.atan2(p2.y - p1.y, p2.x - p1.x), L = Math.min(18, Math.max(10, Math.hypot(p2.x - p1.x, p2.y - p1.y) * .35));
        skLine(c, r, p2.x, p2.y, p2.x - L * Math.cos(ang - .46), p2.y - L * Math.sin(ang - .46), 1);
        skLine(c, r, p2.x, p2.y, p2.x - L * Math.cos(ang + .46), p2.y - L * Math.sin(ang + .46), 1);
        if(lbl){
          const mx = (p1.x + p2.x) / 2, my = (p1.y + p2.y) / 2;
          const m = measureText(lbl, 14);
          c.save(); c.fillStyle = C.ground; c.fillRect(mx - m.w/2, my - m.h/2, m.w, m.h); c.restore();
          drawMultiline(c, lbl, mx, my, 14, ink);
        }
        break;
      }
      case 'pen': {
        c.setLineDash([]); c.lineWidth = 2.1;
        if(e.pts.length < 2){
          c.beginPath(); c.fillStyle = ink; c.arc(e.pts[0][0], e.pts[0][1], 1.2, 0, 7); c.fill();
          break;
        }
        c.beginPath(); c.moveTo(e.pts[0][0], e.pts[0][1]);
        for(let i = 1; i < e.pts.length - 1; i++){
          const x0 = e.pts[i][0], y0 = e.pts[i][1], x1 = e.pts[i+1][0], y1 = e.pts[i+1][1];
          c.quadraticCurveTo(x0, y0, (x0 + x1) / 2, (y0 + y1) / 2);
        }
        const last = e.pts[e.pts.length - 1]; c.lineTo(last[0], last[1]);
        c.stroke();
        break;
      }
    }
  }

  function drawSelection(c){
    if(!selected.size) return;
    const pad = 6 / view.scale;
    c.save();
    c.strokeStyle = C.accent; c.lineWidth = 1 / view.scale; c.setLineDash([5 / view.scale, 4 / view.scale]);
    for(const e of els){
      if(!selected.has(e.id) || (editing && editing.id === e.id && e.type === 'text')) continue; // a text being typed is framed by its editor, not by a stale outline
      const b = bbox(e);
      c.strokeRect(b.x - pad, b.y - pad, b.w + pad * 2, b.h + pad * 2);
    }
    c.setLineDash([]);
    const e = selOne(); // handles only apply to a single element
    if(e && !(editing && editing.id === e.id && e.type === 'text')){
      const b = bbox(e);
      c.fillStyle = C.ground; c.strokeStyle = C.accent; c.lineWidth = 1.5 / view.scale;
      // the drawn handle never exceeds its clickable zone, which is capped on small shapes
      const hs = isBoxy(e) ? Math.min(5 / view.scale, b.w / 6, b.h / 6) : 5 / view.scale;
      for(const h of handles(e)){
        c.beginPath(); c.rect(h.x - hs, h.y - hs, hs * 2, hs * 2); c.fill(); c.stroke();
      }
    }
    c.restore();
  }

  // the box an arrow end is about to latch onto lights up while the end is dragged
  function drawSnapTarget(c){
    if(!drag || !drag.snapId) return;
    const t = els.find(e => e.id === drag.snapId); if(!t) return;
    const b = bbox(t), pad = 5 / view.scale;
    c.save(); c.strokeStyle = C.accent; c.globalAlpha = .55; c.lineWidth = 2.5 / view.scale; c.setLineDash([]);
    c.beginPath(); c.roundRect ? c.roundRect(b.x - pad, b.y - pad, b.w + pad * 2, b.h + pad * 2, 10) : c.rect(b.x - pad, b.y - pad, b.w + pad * 2, b.h + pad * 2); c.stroke();
    c.restore();
  }
  function drawMarquee(c){
    if(!drag || drag.mode !== 'marquee' || !drag.moved) return;
    const r = marqueeRect();
    c.save();
    c.strokeStyle = C.accent; c.fillStyle = C.accent; c.lineWidth = 1 / view.scale;
    c.setLineDash([4 / view.scale, 3 / view.scale]);
    c.globalAlpha = .08; c.fillRect(r.x, r.y, r.w, r.h);
    c.globalAlpha = 1; c.strokeRect(r.x, r.y, r.w, r.h);
    c.restore();
  }

  function drawGrid(c, w, h){
    const s = view.scale, step = GRID * (s < .5 ? 4 : s < .9 ? 2 : 1);
    const x0 = -view.x / s, y0 = -view.y / s, x1 = x0 + w / s, y1 = y0 + h / s;
    if(step * s < 6) return;
    c.fillStyle = C.grid;
    const r = Math.max(.9, 1.1 / s);
    for(let x = Math.floor(x0 / step) * step; x < x1; x += step){
      for(let y = Math.floor(y0 / step) * step; y < y1; y += step){
        c.fillRect(x - r/2, y - r/2, r, r);
      }
    }
  }

  // ---------- images ----------
  // decoded pictures are cached by their bytes (copies share one), most recently drawn last, and the
  // cache always holds at least every picture on the board, so a frame never evicts what it is about to draw
  const imgCache = new Map();
  function imageFor(e){
    if(!e.src) return null;
    let img = imgCache.get(e.src);
    if(img){ imgCache.delete(e.src); imgCache.set(e.src, img); return img; }
    img = new Image(); img.onload = () => kick(); img.src = e.src;
    imgCache.set(e.src, img);
    const keep = Math.max(64, els.reduce((n, x) => n + (x.type === 'image' ? 1 : 0), 0) + 8);
    while(imgCache.size > keep) imgCache.delete(imgCache.keys().next().value);
    return img;
  }
  const imgBytes = () => els.reduce((n, e) => n + (e.type === 'image' && e.src ? e.src.length : 0), 0);
  // shrink a picked/pasted/dropped file to something the board can carry inline, then place it
  async function insertImage(file, at){
    if(!file || !/^image\//.test(file.type)){ toast('That isn’t an image file.'); return; }
    let bmp;
    try{ bmp = await createImageBitmap(file); }catch(_){ toast('Couldn’t read that image.'); return; }
    const MAX_SIDE = 1600, scale = Math.min(1, MAX_SIDE / Math.max(bmp.width, bmp.height));
    const cw = Math.max(1, Math.round(bmp.width * scale)), ch = Math.max(1, Math.round(bmp.height * scale));
    const off = document.createElement('canvas'); off.width = cw; off.height = ch;
    off.getContext('2d').drawImage(bmp, 0, 0, cw, ch);
    let src = file.type === 'image/png' && file.size < 350000 ? off.toDataURL('image/png') : '';
    if(!src || src.length > IMG_MAX_CHARS * .6){
      // JPEG has no alpha: transparent pixels would come out black, so they are laid on white first
      const ctx2 = off.getContext('2d'); ctx2.globalCompositeOperation = 'destination-over'; ctx2.fillStyle = '#fff'; ctx2.fillRect(0, 0, cw, ch);
      for(let q = .85; (!src || src.length > IMG_MAX_CHARS * .6) && q >= .4; q -= .15) src = off.toDataURL('image/jpeg', q);
    }
    if(!IMG_SRC_RE.test(src) || src.length > IMG_MAX_CHARS){ toast('That image is too large for the board.'); return; }
    if(imgBytes() + src.length > IMG_MAX_TOTAL){ toast('The board can’t hold more image data — remove a picture first.'); return; }
    const w = Math.min(360, cw), h = Math.round(w * ch / cw);
    const p = at || screenToWorld(board.clientWidth / 2, board.clientHeight / 2);
    const el = {id: uid(), type: 'image', x: snapv(p.x - w / 2), y: snapv(p.y - h / 2), w, h, src, label: (file.name || '').slice(0, 120), seed: 1 + Math.floor(Math.random() * 1e9)};
    mutate(() => { els.push(el); selected = new Set([el.id]); });
    setTool('select');
  }
  board.addEventListener('dragover', ev => { if(ev.dataTransfer && Array.from(ev.dataTransfer.items || []).some(i => i.kind === 'file')) ev.preventDefault(); });
  board.addEventListener('drop', ev => {
    const f = ev.dataTransfer && Array.from(ev.dataTransfer.files || []).find(x => /^image\//.test(x.type));
    if(!f) return;
    ev.preventDefault();
    const {sx, sy} = evtPoint(ev); insertImage(f, screenToWorld(sx, sy));
  });
  window.addEventListener('paste', ev => {
    if(editing || ev.target.tagName === 'TEXTAREA' || ev.target.tagName === 'INPUT') return;
    const f = ev.clipboardData && Array.from(ev.clipboardData.files || []).find(x => /^image\//.test(x.type));
    if(f){ ev.preventDefault(); insertImage(f, null); }
  });

  // ---------- main render ----------
  function render(){
    const w = board.clientWidth, h = board.clientHeight;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    ctx.setTransform(dpr * view.scale, 0, 0, dpr * view.scale, dpr * view.x, dpr * view.y);
    drawGrid(ctx, w, h);
    if(glowIds.size && Date.now() > glowUntil) glowIds = new Set();
    for(const e of els) drawElement(ctx, ghosts.get(e.id) || e);
    for(const g of ghosts.values()) if(!els.some(e => e.id === g.id)) drawElement(ctx, g); // a shape still being drawn elsewhere
    ctx.setLineDash([]);
    drawSnapTarget(ctx);
    drawSelection(ctx);
    drawMarquee(ctx);
    drawCursors(ctx);
    drawClaudeCursor(ctx);
    if(!els.length && !ghosts.size){
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.textAlign = 'center'; ctx.fillStyle = C.muted; ctx.font = handFont(22);
      ctx.fillText('drag anywhere to sketch a box, then draw arrows between things', w / 2, h / 2 - 12);
      ctx.font = '12.5px ' + C.ui; ctx.fillStyle = C.muted;
      ctx.fillText('Ask Claude hands the board over · Claude answers here in orange, and may jump in live', w / 2, h / 2 + 18);
      ctx.textAlign = 'start';
    }
    document.getElementById('zoomVal').textContent = Math.round(view.scale * 100) + '%';
    positionAnchors();
    syncEditor();
    updateSizer();
    if(glowIds.size) kick(); // keep the halo fading
  }
  // animation frames funnel through one pending request, however many things are moving
  let rafPending = false;
  function kick(){ if(rafPending) return; rafPending = true; requestAnimationFrame(() => { rafPending = false; render(); }); }
  // other people's pointers: a small arrow in that tab's hue that fades once it stops moving
  let cursorTimer = null;
  function drawCursors(c){
    clearTimeout(cursorTimer);
    if(!cursors.length) return;
    const now = Date.now(), s = 1 / view.scale;
    let any = false;
    c.save(); c.setLineDash([]);
    for(const p of cursors){
      const a = Math.max(0, 1 - (now - p.at) / 5000);
      if(a <= 0) continue;
      any = true;
      c.globalAlpha = .85 * a;
      c.fillStyle = 'hsl(' + p.hue + ' 65% 52%)'; c.strokeStyle = C.ground; c.lineWidth = 1.5 * s;
      c.beginPath(); c.moveTo(p.x, p.y); c.lineTo(p.x + 9 * s, p.y + 13 * s); c.lineTo(p.x + 3.5 * s, p.y + 11 * s); c.lineTo(p.x, p.y + 16 * s); c.closePath();
      c.fill(); c.stroke();
    }
    c.restore();
    if(any) cursorTimer = setTimeout(kick, 400); // keep fading without a pointer event of our own
  }

  function resize(){
    dpr = Math.max(1, window.devicePixelRatio || 1);
    board.width = Math.round(board.clientWidth * dpr);
    board.height = Math.round(board.clientHeight * dpr);
    render();
  }
  window.addEventListener('resize', resize);

  // ---------- tools & toolbar ----------
  const toolKeys = {h: 'hand', v: 'select', '1': 'select', r: 'rect', '2': 'rect', y: 'diamond', '3': 'diamond', o: 'ellipse', '4': 'ellipse',
    d: 'cylinder', s: 'sticky', a: 'arrow', '5': 'arrow', l: 'line', '6': 'line', p: 'pen', '7': 'pen', t: 'text', '8': 'text', e: 'eraser', '0': 'eraser'};
  const STYLED = t => t !== 'hand' && t !== 'eraser' && t !== 'select' && t !== 'text';
  function setTool(t){
    if(!document.querySelector('.tb[data-tool="' + t + '"]')) t = 'rect'; // a stored tool this page no longer has
    tool = t;
    document.querySelectorAll('.tb').forEach(b => b.setAttribute('aria-pressed', b.dataset.tool === t ? 'true' : 'false'));
    board.className = t === 'select' ? '' : t === 'hand' ? 'grab' : t === 'eraser' ? 'erase' : 'crosshair';
    board.style.cursor = '';
    syncStylebar();
    saveSession();
  }
  document.querySelectorAll('.tb').forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool)));

  // ---------- style panel ----------
  // Shows while a drawing tool is armed or something restylable is selected. The swatches show
  // what the selection has in common, else the style the next shape will be drawn with;
  // a click sets that default and restyles every selected element the property applies to.
  const stylebar = document.getElementById('stylebar');
  const canStroke = e => e.type !== 'sticky' && e.type !== 'image' && !byClaude(e);
  const canFill = e => isShape(e) && e.type !== 'sticky';
  const canDash = e => e.type !== 'pen' && e.type !== 'text' && e.type !== 'sticky' && e.type !== 'image';
  function shownStyle(){
    const sel = els.filter(e => selected.has(e.id));
    if(!sel.length) return style;
    // what the selection has in common; a mixed property presses no swatch
    const same = (list, f) => { const v = [...new Set(list.map(f))]; return v.length === 1 ? v[0] : null; };
    return {stroke: same(sel.filter(canStroke), e => e.stroke || 'ink'), fill: same(sel.filter(canFill), e => e.fill || 'none'), dash: same(sel.filter(canDash), e => !!e.dash)};
  }
  function syncStylebar(){
    const sel = els.filter(e => selected.has(e.id));
    const show = STYLED(tool) || sel.some(e => canStroke(e) || canFill(e) || canDash(e) || e.type === 'text');
    stylebar.hidden = !show;
    if(!show) return;
    const s = shownStyle(), one = selOne();
    // Claude's marks keep their orange: the row shows that swatch, locked, instead of a colour they don't have
    stylebar.dataset.claude = one && byClaude(one) ? '1' : '';
    stylebar.querySelectorAll('[data-stroke]').forEach(b => b.setAttribute('aria-pressed', String(!stylebar.dataset.claude && b.dataset.stroke === s.stroke)));
    const fillable = sel.some(canFill); // new shapes start unfilled, so with nothing fillable selected the swatches have nothing to act on
    stylebar.querySelectorAll('[data-fill]').forEach(b => { b.disabled = !fillable; b.setAttribute('aria-pressed', String(fillable && b.dataset.fill === s.fill)); });
    stylebar.querySelectorAll('[data-dash]').forEach(b => b.setAttribute('aria-pressed', String((b.dataset.dash === '1') === s.dash)));
  }
  function applyStyle(patch){
    // fill is per element: a swatch fills the selection, and new shapes still start unfilled
    Object.assign(style, patch, {fill: 'none'});
    const targets = els.filter(e => selected.has(e.id) && (
      ('stroke' in patch && canStroke(e)) || ('fill' in patch && canFill(e)) || ('dash' in patch && canDash(e))));
    if(targets.length) mutate(() => { for(const e of targets){
      if('stroke' in patch && canStroke(e)){ if(patch.stroke === 'ink') delete e.stroke; else e.stroke = patch.stroke; }
      if('fill' in patch && canFill(e)){ if(patch.fill === 'none') delete e.fill; else e.fill = patch.fill; }
      if('dash' in patch && canDash(e)){ if(patch.dash) e.dash = true; else delete e.dash; }
    }});
    else saveSession();
    syncStylebar();
  }
  stylebar.addEventListener('click', ev => {
    const b = ev.target.closest('button'); if(!b) return;
    if(b.dataset.stroke) applyStyle({stroke: b.dataset.stroke});
    else if(b.dataset.fill) applyStyle({fill: b.dataset.fill});
    else if(b.hasAttribute('data-dash')) applyStyle({dash: b.dataset.dash === '1'});
  });
  // a new element starts with the panel's style; defaults stay off the wire
  function styled(el){
    if(style.stroke !== 'ink' && el.type !== 'sticky') el.stroke = style.stroke;
    if(style.dash && canDash(el)) el.dash = true;
    return el;
  }

  // ---------- pointer interaction ----------
  function evtPoint(ev){
    const r = board.getBoundingClientRect();
    return {sx: ev.clientX - r.left, sy: ev.clientY - r.top};
  }
  board.addEventListener('contextmenu', ev => ev.preventDefault());
  // ---------- context menu + comments ----------
  const ctxMenu = document.getElementById('ctx');
  let ctxTarget = null;
  function closeCtx(){ ctxMenu.classList.remove('open'); ctxTarget = null; }
  function openCtx(e, sx, sy){
    ctxTarget = e; selected = new Set([e.id]); syncStylebar(); render();
    ctxMenu.style.left = Math.min(sx, window.innerWidth - 180) + 'px'; ctxMenu.style.top = Math.min(sy, window.innerHeight - 120) + 'px';
    document.getElementById('ctxComment').disabled = false;
    ctxMenu.classList.add('open');
  }
  document.addEventListener('pointerdown', ev => { if(!ctxMenu.contains(ev.target)) closeCtx(); }, true);
  // comment threads hang off the published anchor for an element; one that has never been
  // sent has nothing to hang on yet
  let commentsApi;
  async function commentOn(e){
    if(!e) return;
    const anchor = document.getElementById('wb-a-' + e.id);
    if(!anchor){ toast('Comments attach to elements that have been sent or saved — Ask Claude (or Save for everyone) first.', 5000); return; }
    if(!commentsApi) commentsApi = await cap('comments'); // a runtime that attaches a beat late is asked again, not written off
    if(!commentsApi || typeof commentsApi.openComposer !== 'function'){ toast('Commenting isn’t available in this view.'); return; }
    positionAnchors();
    commentsApi.openComposer({element: anchor}).then(r => { if(r && r.opened === false) toast('Finish the comment you have open first.'); })
      .catch(err => toast((err && err.code) === 'unavailable' ? 'Commenting isn’t available in this view.' : 'Couldn’t open a comment here.'));
  }
  document.getElementById('ctxComment').onclick = () => { const e = ctxTarget; closeCtx(); commentOn(e); };
  document.getElementById('ctxDup').onclick = () => { closeCtx(); duplicateSelected(); };
  document.getElementById('ctxDel').onclick = () => { closeCtx(); deleteSelected(); };
  function duplicateSelected(){
    let picks = els.filter(e => selected.has(e.id)); if(!picks.length) return;
    const extra = picks.reduce((n, e) => n + (e.type === 'image' && e.src ? e.src.length : 0), 0);
    if(extra && imgBytes() + extra > IMG_MAX_TOTAL){
      toast('The board can\u2019t hold more image data \u2014 the pictures were left out of the copy.');
      picks = picks.filter(e => e.type !== 'image'); if(!picks.length) return;
    }
    const copies = picks.map(e => { const c = clone(e); c.id = uid(); delete c.author; delete c.mv; moveElement(c, e, GRID * 2, GRID * 2); if(c.type === 'arrow'){ c.fromId = null; c.toId = null; } return c; });
    mutate(() => { els = els.concat(copies); selected = new Set(copies.map(c => c.id)); });
  }
  // anchors sit exactly over their shapes in screen space; run after every render
  const anchorLayer = () => document.getElementById('wb-anchors');
  function positionAnchors(){
    const layer = anchorLayer(); if(!layer) return;
    const byId = new Map(els.map(e => [e.id, e]));
    for(const a of layer.children){
      const e = byId.get(a.id.slice(5));
      if(!e){ a.style.display = 'none'; continue; }
      const b = bbox(e), s = worldToScreen(b.x, b.y);
      a.style.display = 'block'; a.style.left = s.x + 'px'; a.style.top = s.y + 'px';
      a.style.width = Math.max(8, b.w * view.scale) + 'px'; a.style.height = Math.max(8, b.h * view.scale) + 'px';
    }
  }
  board.addEventListener('dblclick', ev => {
    const {sx, sy} = evtPoint(ev); const p = screenToWorld(sx, sy);
    const e = hit(p);
    if(e && e.type !== 'pen' && e.type !== 'line' && e.type !== 'image') startEdit(e);
  });

  board.addEventListener('pointerdown', ev => {
    if(editing) return;
    typeTarget = null;
    board.setPointerCapture(ev.pointerId);
    const {sx, sy} = evtPoint(ev); const p = screenToWorld(sx, sy);
    if(ev.button === 2){ const over = hit(p); if(over){ openCtx(over, ev.clientX, ev.clientY); return; } }
    const panIntent = ev.button === 1 || spaceHeld || ev.button === 2 || tool === 'hand';
    if(panIntent){ startPan(sx, sy); return; }
    if(ev.button !== 0) return;

    if(tool === 'eraser'){
      // one gesture is one undo step: everything the eraser passes over goes together
      selected.clear(); beginChange();
      drag = {mode: 'erase', gone: new Set()};
      eraseAt(p);
      render();
      return;
    }

    if(tool === 'select'){
      const toggle = ev.shiftKey || ev.ctrlKey || ev.metaKey; // shift/ctrl/cmd grow or shrink the selection
      const sel = selOne();
      const h = toggle ? null : handleAt(p, sel);
      if(h){
        beginChange();
        drag = {mode: h.kind, id: sel.id, sx, sy, moved: false};
        if(h.kind === 'resize'){
          // the opposite side stays put while this handle follows the pointer; an edge handle moves one axis
          const b = normRect(sel);
          sel.x = b.x; sel.y = b.y; sel.w = b.w; sel.h = b.h;
          drag.ax = h.corner.includes('w') ? b.x + b.w : h.corner.includes('e') ? b.x : null;
          drag.ay = h.corner.includes('n') ? b.y + b.h : h.corner.includes('s') ? b.y : null;
          drag.ratio = sel.type === 'image' && b.h ? b.w / b.h : null;
        }
        board.classList.add('move');
        return;
      }
      const e = hit(p);
      if(e && toggle){
        selected.has(e.id) ? selected.delete(e.id) : selected.add(e.id);
        saveSession(); syncStylebar(); render();
      } else if(e){
        if(!selected.has(e.id)) selected = new Set([e.id]);
        beginChange();
        // every selected element moves by the grabbed one's snapped delta, measured from its
        // starting corner captured once here (a bound arrow's box would shift as its shapes move)
        const b = bbox(e);
        drag = {mode: 'move', id: e.id, offX: p.x - b.x, offY: p.y - b.y, ax0: b.x, ay0: b.y, sx, sy, origs: new Map(), moved: false};
        for(const x of els) if(selected.has(x.id)) drag.origs.set(x.id, clone(x));
        board.classList.add('move');
        saveSession(); render();
      } else if(ev.pointerType === 'touch'){
        selected.clear(); saveSession(); render(); startPan(sx, sy); // no marquee on touch: a drag is the only pan gesture
      } else {
        // empty canvas: a drag rubber-bands a selection (kept and toggled when a modifier is held)
        drag = {mode: 'marquee', start: p, end: p, sx, sy, base: toggle ? new Set(selected) : new Set(), moved: false};
        render();
      }
      return;
    }

    // drawing tools
    selected.clear();
    beginChange();
    const seed = 1 + Math.floor(Math.random() * 1e9);
    if(tool === 'text'){
      // stop the browser's mousedown focus shuffle so the editor keeps focus once it opens
      ev.preventDefault(); pending = null; // history handled when the text commits
      const over = hit(p);
      if(over && over.type !== 'pen' && over.type !== 'line' && over.type !== 'image'){ setTimeout(() => startEdit(over), 0); return; }
      const el = styled({id: uid(), type: 'text', x: snapv(p.x), y: snapv(p.y), text: '', size: textSize, seed});
      els.push(el); render();
      setTimeout(() => startEdit(el, true), 0);
      return;
    }
    const startedOn = hit(p);
    if(tool === 'arrow' || tool === 'line'){
      const el = styled({id: uid(), type: tool, x1: snapv(p.x), y1: snapv(p.y), x2: snapv(p.x), y2: snapv(p.y), seed, label: '',
                  fromId: tool === 'arrow' ? (shapeAt(p) || {}).id || null : null, toId: null});
      els.push(el); drag = {mode: 'create-line', id: el.id};
    } else if(tool === 'pen'){
      const el = styled({id: uid(), type: 'pen', pts: [[p.x, p.y]], seed});
      els.push(el); drag = {mode: 'create-pen', id: el.id};
    } else {
      const el = styled({id: uid(), type: tool, x: snapv(p.x), y: snapv(p.y), w: 0, h: 0, seed, label: ''});
      els.push(el); drag = {mode: 'create-shape', id: el.id, start: p, startedOn: startedOn ? startedOn.id : null};
    }
    render();
  });

  function startPan(sx, sy){
    drag = {mode: 'pan', sx, sy, vx: view.x, vy: view.y};
    board.style.cursor = ''; // the grabbing class carries the pan cursor; a leftover hover cursor would override it
    board.classList.add('grabbing');
  }

  // everything under the eraser goes; arrows bound to an erased box let go where they were
  function eraseAt(p){
    const e = hit(p, 9 / view.scale);
    if(!e || drag.gone.has(e.id)) return;
    drag.gone.add(e.id);
    if(isConnectable(e)){
      const c = center(e);
      for(const a of els){
        if(a.type !== 'arrow') continue;
        if(a.fromId === e.id){ a.x1 = c.x; a.y1 = c.y; a.fromId = null; }
        if(a.toId === e.id){ a.x2 = c.x; a.y2 = c.y; a.toId = null; }
      }
    }
    els = els.filter(x => x.id !== e.id);
  }

  board.addEventListener('pointerleave', () => sharePointer(null));
  board.addEventListener('pointermove', ev => {
    const {sx, sy} = evtPoint(ev); const p = screenToWorld(sx, sy);
    sharePointer(p);
    if(!drag){
      // cursor feedback in select mode: resize arrows over a handle, move over a shape
      if(tool !== 'select' || spaceHeld) return;
      const sel = selOne(), h = handleAt(p, sel);
      const cur = h ? handleCursor(h) : hit(p) ? 'move' : '';
      if(cur !== board.style.cursor) board.style.cursor = cur;
      return;
    }
    const e = drag.id ? els.find(x => x.id === drag.id) : null;
    switch(drag.mode){
      case 'erase':
        eraseAt(p); break;
      case 'pan':
        view.x = drag.vx + (sx - drag.sx); view.y = drag.vy + (sy - drag.sy); break;
      case 'move': {
        if(!drag.moved && Math.hypot(sx - drag.sx, sy - drag.sy) < CLICK_PX) break;
        drag.moved = true;
        const {dx, dy} = moveDelta(p, drag);
        for(const el of els){ const o = drag.origs.get(el.id); if(o) moveElement(el, o, dx, dy); }
        break;
      }
      case 'marquee': {
        drag.end = p;
        if(!drag.moved && Math.hypot(sx - drag.sx, sy - drag.sy) < CLICK_PX) break;
        drag.moved = true;
        const r = marqueeRect();
        selected = resolveMarquee(drag.base, els.filter(x => rectsIntersect(r, bbox(x))).map(x => x.id));
        break;
      }
      case 'resize': {
        if(!drag.moved && Math.hypot(sx - drag.sx, sy - drag.sy) < CLICK_PX) break;
        drag.moved = true;
        // the dragged side follows the pointer, the anchored side never moves; crossing it flips the box
        if(drag.ax != null){
          let px = snapv(p.x);
          if(Math.abs(px - drag.ax) < 20) px = drag.ax + (px >= drag.ax ? 20 : -20);
          e.x = Math.min(drag.ax, px); e.w = Math.abs(px - drag.ax);
        }
        if(drag.ay != null){
          let py = snapv(p.y);
          if(Math.abs(py - drag.ay) < 20) py = drag.ay + (py >= drag.ay ? 20 : -20);
          e.y = Math.min(drag.ay, py); e.h = Math.abs(py - drag.ay);
        }
        if(e.type === 'image' && drag.ratio){ // pictures keep their proportions from whichever side leads
          if(drag.ax != null && (drag.ay == null || e.w / drag.ratio >= e.h)){ e.h = Math.round(e.w / drag.ratio); if(drag.ay != null && p.y < drag.ay) e.y = drag.ay - e.h; }
          else { e.w = Math.round(e.h * drag.ratio); if(drag.ax != null && p.x < drag.ax) e.x = drag.ax - e.w; }
        }
        break;
      }
      case 'p1': case 'p2': {
        // a click on an endpoint handle leaves the endpoint and its binding untouched
        if(!drag.moved && Math.hypot(sx - drag.sx, sy - drag.sy) < CLICK_PX) break;
        drag.moved = true;
        const k = drag.mode === 'p1' ? 1 : 2;
        e['x' + k] = snapv(p.x); e['y' + k] = snapv(p.y);
        if(e.type === 'arrow'){
          const other = k === 1 ? e.toId : e.fromId;
          const over = snapShape(p, other);
          e[k === 1 ? 'fromId' : 'toId'] = over ? over.id : null;
          drag.snapId = over ? over.id : null;
        }
        break;
      }
      case 'create-shape':
        e.w = snapv(p.x) - e.x; e.h = snapv(p.y) - e.y;
        if(e.type === 'sticky'){ const side = Math.max(Math.abs(e.w), Math.abs(e.h)); e.w = Math.sign(e.w || 1) * side; e.h = Math.sign(e.h || 1) * side; } // notes are square as drawn; handles reshape them later
        break;
      case 'create-line':
        e.x2 = snapv(p.x); e.y2 = snapv(p.y);
        if(e.type === 'arrow'){ const over = snapShape(p, e.fromId); e.toId = over ? over.id : null; drag.snapId = e.toId; }
        break;
      case 'create-pen': {
        const last = e.pts[e.pts.length - 1];
        if(Math.hypot(p.x - last[0], p.y - last[1]) > 2 / view.scale) e.pts.push([p.x, p.y]);
        break;
      }
    }
    if(e && drag.mode !== 'erase') netLive(e);
    render();
  });

  board.addEventListener('pointerup', () => finishDrag());
  board.addEventListener('pointercancel', () => finishDrag());

  function marqueeRect(){
    return {x: Math.min(drag.start.x, drag.end.x), y: Math.min(drag.start.y, drag.end.y),
            w: Math.abs(drag.end.x - drag.start.x), h: Math.abs(drag.end.y - drag.start.y)};
  }

  function finishDrag(){
    if(!drag) return;
    const e = drag.id ? els.find(x => x.id === drag.id) : null;
    board.classList.remove('grabbing', 'move');
    if(drag.mode === 'pan'){ saveSession(); drag = null; render(); return; }
    if(drag.mode === 'erase'){ endChange(); drag = null; syncStylebar(); render(); return; }
    if(drag.mode === 'marquee'){
      if(!drag.moved) selected = drag.base; // a click on empty canvas clears (or, with a modifier, keeps) the selection
      saveSession(); drag = null; syncStylebar(); render(); return;
    }
    // a click that moved nothing, on one of several selected elements, narrows the selection to it
    if(drag.mode === 'move' && !drag.moved && selected.size > 1) selected = new Set([drag.id]);
    if(drag.mode === 'create-shape'){
      const b = normRect(e);
      if(b.w < 8 && b.h < 8){
        // a plain click: on an existing thing it selects, on empty space it drops a default box
        if(drag.startedOn){ els = els.filter(x => x.id !== e.id); selected = new Set([drag.startedOn]); }
        else if(e.type === 'sticky'){ e.x -= STICKY_SIDE / 2; e.y -= STICKY_SIDE / 2; e.w = e.h = STICKY_SIDE; selected = new Set([e.id]); typeTarget = e.id; }
        else { e.x -= 60; e.y -= 30; e.w = 120; e.h = 60; selected = new Set([e.id]); typeTarget = e.id; }
      } else { e.x = b.x; e.y = b.y; e.w = Math.max(20, b.w); e.h = Math.max(20, b.h); selected = new Set([e.id]); typeTarget = e.id; }
      setTool('select'); // back to the pointer after each shape so the next drag moves rather than draws
    }
    if(drag.mode === 'create-line'){
      if(Math.hypot(e.x2 - e.x1, e.y2 - e.y1) < 6){ els = els.filter(x => x.id !== e.id); }
      else selected = new Set([e.id]);
    }
    endChange();
    endLive();
    drag = null;
    saveSession();
    syncStylebar();
    render();
  }

  // the group-move delta: pointer offset from the grab anchor captured at pointerdown, snapped;
  // never re-measured from the grabbed element, whose box can depend on shapes in motion
  function moveDelta(p, grab){
    return {dx: snapv(p.x - grab.offX) - grab.ax0, dy: snapv(p.y - grab.offY) - grab.ay0};
  }
  function moveElement(e, orig, dx, dy){
    switch(e.type){
      case 'arrow': case 'line':
        e.x1 = orig.x1 + dx; e.y1 = orig.y1 + dy; e.x2 = orig.x2 + dx; e.y2 = orig.y2 + dy; break;
      case 'pen':
        e.pts = orig.pts.map(([x, y]) => [x + dx, y + dy]); break;
      case 'text': e.x = orig.x + dx; e.y = orig.y + dy; break;
      default: { const b = normRect(orig); e.x = b.x + dx; e.y = b.y + dy; e.w = b.w; e.h = b.h; }
    }
  }

  // ---------- wheel: pan / zoom ----------
  board.addEventListener('wheel', ev => {
    ev.preventDefault();
    const {sx, sy} = evtPoint(ev);
    if(ev.ctrlKey || ev.metaKey) zoomAt(sx, sy, Math.exp(-ev.deltaY * 0.01));
    else { view.x -= ev.deltaX; view.y -= ev.deltaY; }
    render(); saveSession();
  }, {passive: false});

  function zoomAt(sx, sy, factor){
    const before = screenToWorld(sx, sy);
    view.scale = Math.min(4, Math.max(0.15, view.scale * factor));
    view.x = sx - before.x * view.scale;
    view.y = sy - before.y * view.scale;
  }
  function zoomFit(){
    const b = boundsOfAll();
    const w = board.clientWidth, h = board.clientHeight;
    if(!b){ view = {x: 0, y: 0, scale: 1}; render(); saveSession(); return; }
    const pad = 80;
    const s = Math.min(2, Math.min((w - pad*2) / b.w, (h - pad*2) / b.h));
    view.scale = Math.max(0.15, s);
    view.x = (w - b.w * view.scale) / 2 - b.x * view.scale;
    view.y = (h - b.h * view.scale) / 2 - b.y * view.scale;
    render(); saveSession();
  }
  // fit only when nothing on the board is in view: a load or a merge should never strand
  // the viewer on empty canvas, but must not yank a view they chose
  function nothingInView(list){
    if(!list.length || !board.clientWidth) return false;
    const s = view.scale, port = {x: -view.x / s, y: -view.y / s, w: board.clientWidth / s, h: board.clientHeight / s};
    return !list.some(e => rectsIntersect(port, bbox(e)));
  }
  document.getElementById('zoomIn').onclick = () => { zoomAt(board.clientWidth/2, board.clientHeight/2, 1.25); render(); saveSession(); };
  document.getElementById('zoomOut').onclick = () => { zoomAt(board.clientWidth/2, board.clientHeight/2, 0.8); render(); saveSession(); };
  document.getElementById('zoomFit').onclick = () => { closeMenu(); zoomFit(); };
  document.getElementById('zoomVal').onclick = zoomFit;

  // ---------- label editing ----------
  function startEdit(e, fresh = false){
    if(editing && editing !== e) commitEdit();
    editing = e; selected = new Set([e.id]); editAnchor = null; render();
    const isSticky = e.type === 'sticky', isText = e.type === 'text', isArrow = e.type === 'arrow';
    const px = (isSticky ? STICKY_FONT : isArrow ? 14 : isText ? textPx(e) : FONT_SIZE) * view.scale;
    const tw = isText ? measureText(e.text || '', textPx(e)).w : isArrow ? measureText(e.label || '', 14).w : 0;
    const ib = innerBox(e);
    const b = isText || isArrow ? {w: Math.max(120, tw + 16), h: 30} : isSticky ? normRect(e) : {w: Math.max(12, ib.w), h: Math.max(12, ib.h)};
    // resolve the final on-screen width first so a centered editor is centered on that width
    const sw = Math.max(isText || isArrow ? 90 : 12, b.w * view.scale);
    let left, top;
    if(isText){ const s = worldToScreen(e.x, e.y); left = s.x; top = s.y; }
    else if(isArrow){ const {p1, p2} = arrowEndpoints(e); const s = worldToScreen((p1.x+p2.x)/2, (p1.y+p2.y)/2 - 14); left = s.x - sw / 2; top = s.y; }
    else if(isSticky){ const s = worldToScreen(normRect(e).x, normRect(e).y); left = s.x; top = s.y; }
    else { const s = worldToScreen(ib.cx - b.w / 2, ib.cy - b.h / 2); left = s.x; top = s.y; } // the shape's own writing area, so text sits where it will render
    editor.value = isText ? (e.text || '') : (e.label || '');
    editor.style.left = left + 'px'; editor.style.top = top + 'px';
    editor.style.transform = '';
    editAnchor = screenToWorld(left, top); editScale = view.scale;
    editor.style.width = sw + 'px';
    const lines = Math.max(1, editor.value.split('\n').length);
    editor.style.height = Math.max(isText || isArrow ? 30 : 12, (isText ? textPx(e) * 1.35 * lines : isArrow ? 30 : b.h) * view.scale) + 'px';
    editor.style.fontSize = px + 'px';
    editor.style.lineHeight = (isText ? textPx(e) * 1.35 : (isArrow ? 30 : b.h) / lines) * view.scale + 'px';
    editor.style.textAlign = isText || isSticky ? 'left' : 'center';
    editor.style.padding = isSticky ? (STICKY_PAD - 2) * view.scale + 'px ' + STICKY_PAD * view.scale + 'px' : isText || isArrow ? '' : '0';
    editor.style.color = 'transparent'; editor.style.caretColor = isSticky ? stickyPaper(e).ink : strokeColor(e);
    editor.style.display = 'block';
    editor.focus(); editor.select();
    editor.dataset.fresh = fresh ? '1' : '';
    editor.dataset.fit = isText || isArrow ? '' : '1';
    editor.style.borderColor = editor.dataset.fit && !isSticky ? 'transparent' : ''; // the shape itself frames its label
    // a shape's editor wraps and stays the size of the shape; free text grows as you type
    editor.style.whiteSpace = editor.dataset.fit ? 'pre-wrap' : 'pre';
    editor.style.paddingTop = '';
    if(editor.dataset.fit) fitEditor();
    else if(isText) sizeFreeText();
  }
  // a free text note's editor puts its glyphs exactly where the canvas will draw them (4px in,
  // top baseline), and grows by whole lines and measured width - so nothing jumps on the first
  // keystroke and nothing moves when the edit lands
  function sizeFreeText(){
    const e = editing; if(!e || e.type !== 'text') return;
    // the editor's dashed frame is the selection outline the note will have once committed
    // (bbox plus the 6px halo drawSelection uses), and its glyphs sit where the canvas draws them
    const s = editScale, px = textPx(e), lh = px * 1.35, bw = 1.5, halo = 6, inset = halo + 4;
    const m = measureText(editor.value || ' ', px);
    editAnchor = {x: e.x - halo, y: e.y - halo};
    const o = worldToScreen(editAnchor.x, editAnchor.y);
    editor.style.left = o.x + 'px'; editor.style.top = o.y + 'px';
    editor.style.padding = Math.max(0, inset * s - bw - (lh - px) / 2 * s) + 'px 0 0 ' + Math.max(0, inset * s - bw) + 'px';
    editor.style.lineHeight = lh * s + 'px';
    editor.style.width = (m.w + halo * 2) * s + 'px';
    editor.style.height = (m.h + halo * 2) * s + 'px';
  }
  // the editor is laid out at editScale and pinned to a world point, so a pan or zoom mid-edit
  // carries it with the canvas: re-project its origin and let transform supply the zoom delta
  function syncEditor(){
    if(!editing || !editAnchor) return;
    const s = worldToScreen(editAnchor.x, editAnchor.y);
    editor.style.left = s.x + 'px'; editor.style.top = s.y + 'px';
    editor.style.transform = view.scale === editScale ? '' : 'scale(' + view.scale / editScale + ')';
  }
  // keep the label editor's font matched to what the shape will render as the label changes
  function fitEditor(){
    const e = editing; if(!e) return;
    const maxPx = e.type === 'sticky' ? STICKY_FONT : FONT_SIZE, ib = innerBox(e);
    const f = fitText(ctx, editor.value || ' ', Math.max(12, ib.w), Math.max(12, ib.h), maxPx);
    const lh = f.px * 1.35 * editScale, boxH = parseFloat(editor.style.height) || 0, bw = 1.5, halfLead = (lh - f.px * editScale) / 2;
    editor.style.fontSize = f.px * editScale + 'px';
    editor.style.lineHeight = lh + 'px';
    // glyphs sit where the canvas will draw them: a note writes from its margin (top baseline), a
    // shape centres its block; either way the editor's own border and CSS half-leading are taken out
    if(e.type === 'sticky') editor.style.padding = Math.max(0, (STICKY_PAD - 2) * editScale - bw - halfLead) + 'px ' + Math.max(0, STICKY_PAD * editScale - bw) + 'px 0';
    else editor.style.paddingTop = Math.max(0, (boxH - f.lines.length * lh) / 2 - bw) + 'px';
  }
  function commitEdit(cancel = false){
    if(!editing) return;
    const e = editing; editing = null;
    editor.style.display = 'none';
    editor.blur();
    const val = editor.value.replace(/\s+$/,'');
    const fresh = e.type === 'text' && !!editor.dataset.fresh;
    // a note placed by this edit did not exist before it: the step to undo is the board without it
    if(fresh){ pending = histJson(els.filter(x => x.id !== e.id)); pendingAt = ++seq; } else beginChange();
    if(e.type === 'text'){
      if(cancel ? fresh : !val) els = els.filter(x => x.id !== e.id);
      else if(!cancel) e.text = val;
      if(tool === 'text') setTool('select');
    } else if(!cancel){
      e.label = val;
    }
    endChange();
    if(fresh && els.indexOf(e) === -1) saveLocal(); // a discarded note leaves the draft too, even when no step was recorded
    render();
  }
  editor.addEventListener('keydown', ev => {
    if(ev.key === 'Enter' && !ev.shiftKey){ ev.preventDefault(); commitEdit(); }
    else if(ev.key === 'Escape'){ ev.preventDefault(); commitEdit(true); }
    ev.stopPropagation();
  });
  editor.addEventListener('input', () => {
    render(); // the canvas is what shows the typed text
    if(editor.dataset.fit){ fitEditor(); return; } // shape labels shrink to fit; free text grows the box instead
    if(editing && editing.type === 'text'){ sizeFreeText(); return; }
    const lines = editor.value.split('\n').length;
    const px = parseFloat(editor.style.fontSize) || 16;
    editor.style.height = Math.max(parseFloat(editor.style.height) || 30, lines * px * 1.5 + 8) + 'px';
    const longest = editor.value.split('\n').reduce((m, l) => Math.max(m, l.length), 0);
    editor.style.width = Math.max(parseFloat(editor.style.width) || 90, longest * px * .62 + 24) + 'px';
  });
  editor.addEventListener('blur', () => commitEdit());

  // ---------- keyboard ----------
  window.addEventListener('keydown', ev => {
    if(ev.key === 'Escape' && document.querySelector('.modal.open')){ closeModals(); return; }
    if(editing) return;
    if(ev.target.tagName === 'TEXTAREA' || ev.target.tagName === 'INPUT') return;
    if(drag) return; // a gesture is in flight; keys wait until it finishes
    const mod = ev.ctrlKey || ev.metaKey;
    if(mod && ev.key === 'Enter'){ ev.preventDefault(); sendToClaude(); return; }
    if(mod && ev.key.toLowerCase() === 'z'){ ev.preventDefault(); ev.shiftKey ? redo() : undo(); return; }
    if(mod && ev.key.toLowerCase() === 'y'){ ev.preventDefault(); redo(); return; }
    if(mod && ev.key.toLowerCase() === 'a'){ ev.preventDefault(); typeTarget = null; selected = new Set(els.map(e => e.id)); setTool('select'); render(); return; }
    if(ev.key === ' '){ spaceHeld = true; board.style.cursor = ''; board.classList.add('grab'); ev.preventDefault(); return; }
    if(ev.key === 'Escape'){ closeMenu(); typeTarget = null; selected.clear(); saveSession(); syncStylebar(); render(); return; }
    if((ev.key === 'Delete' || ev.key === 'Backspace') && selected.size){
      ev.preventDefault(); deleteSelected(); return;
    }
    if((ev.key === '[' || ev.key === ']') && !mod){ ev.preventDefault(); stepSize(ev.key === ']' ? 1 : -1); return; }
    // a shape you just drew takes typing as its label; Enter opens the label of whatever is selected
    const sel = selOne(), labelable = sel && sel.type !== 'pen' && sel.type !== 'line' && sel.type !== 'image';
    if(labelable && !mod && !ev.altKey && (ev.key === 'Enter' || (typeTarget === sel.id && ev.key.length === 1 && ev.key !== ' '))){
      ev.preventDefault();
      const ch = ev.key === 'Enter' ? null : ev.key;
      typeTarget = null;
      startEdit(sel);
      if(ch !== null){ editor.value = ch; editor.setSelectionRange(1, 1); editor.dispatchEvent(new Event('input')); }
      return;
    }
    if(ev.key === '!' || (ev.shiftKey && ev.code === 'Digit1')){ ev.preventDefault(); zoomFit(); return; }
    if(ev.key === '?'){ ev.preventDefault(); openKeys(); return; }
    if(mod && ev.key.toLowerCase() === 'd'){ ev.preventDefault(); duplicateSelected(); return; }
    if(!mod && ev.key.toLowerCase() === 'c' && selOne() && typeTarget !== selOne().id){ ev.preventDefault(); commentOn(selOne()); return; }
    const t = toolKeys[ev.key.toLowerCase()];
    if(t && !mod && !ev.altKey && !ev.shiftKey) setTool(t);
  });
  window.addEventListener('keyup', ev => {
    if(ev.key === ' '){ spaceHeld = false; if(tool !== 'hand') board.classList.remove('grab'); }
  });

  function deleteSelected(){
    if(!selected.size) return;
    const gone = new Set(selected);
    mutate(() => {
      // arrows that survive detach from any deleted shape, keeping their visual position
      for(const g of els){
        if(!gone.has(g.id) || !isConnectable(g)) continue;
        const c = center(g);
        for(const a of els){
          if(a.type !== 'arrow' || gone.has(a.id)) continue;
          if(a.fromId === g.id){ a.x1 = c.x; a.y1 = c.y; a.fromId = null; }
          if(a.toId === g.id){ a.x2 = c.x; a.y2 = c.y; a.toId = null; }
        }
      }
      els = els.filter(e => !gone.has(e.id));
      selected.clear();
    });
  }

  // ---------- text size ----------
  // the stepper shows the selected text's size, else the size the next text will be drawn at;
  // stepping always moves that default, and re-sizes a selected text as an undoable edit
  const selectedText = () => { const e = selOne(); return e && e.type === 'text' ? e : null; };
  const sizeVal = document.getElementById('sizeVal');
  function shownSize(){ const t = selectedText(); return t ? textPx(t) : textSize; }
  function updateSizer(){
    const v = String(shownSize());
    if(sizeVal.textContent !== v) sizeVal.textContent = v;
  }
  function stepSize(dir){
    const cur = shownSize();
    // a size off the ladder (e.g. one Claude wrote) steps to its nearest rung in that direction
    let i = TEXT_SIZES.findIndex(s => s >= cur);
    if(i === -1) i = TEXT_SIZES.length;
    const up = TEXT_SIZES[i] > cur ? TEXT_SIZES[i] : TEXT_SIZES[i + 1];
    const next = dir > 0 ? (up || cur) : (TEXT_SIZES[i - 1] || Math.min(cur, TEXT_SIZES[0]));
    textSize = next;
    const t = selectedText();
    if(t && textPx(t) !== next) mutate(() => { t.size = next; });
    else { saveSession(); render(); }
  }
  document.getElementById('sizeDown').onclick = () => stepSize(-1);
  document.getElementById('sizeUp').onclick = () => stepSize(1);

  // ---------- menu, history, modals ----------
  const menu = document.getElementById('menu'), menuBtn = document.getElementById('menuBtn');
  function closeMenu(){ menu.classList.remove('open'); menuBtn.setAttribute('aria-expanded', 'false'); }
  menuBtn.onclick = () => { const open = !menu.classList.contains('open'); menu.classList.toggle('open', open); menuBtn.setAttribute('aria-expanded', String(open)); };
  document.addEventListener('pointerdown', ev => { if(!menu.contains(ev.target) && !menuBtn.contains(ev.target)) closeMenu(); }, true);
  document.getElementById('undoBtn').onclick = undo;
  document.getElementById('redoBtn').onclick = redo;
  function syncSnap(){
    document.getElementById('snapBtn').setAttribute('aria-pressed', String(snap));
    document.getElementById('snapHint').textContent = snap ? 'on' : 'off';
  }
  document.getElementById('snapBtn').onclick = () => { snap = !snap; syncSnap(); saveSession(); };
  document.getElementById('clearBtn').onclick = () => {
    closeMenu();
    if(!els.length) return;
    mutate(() => { els = []; selected.clear(); });
    toast('Board cleared — undo brings it back.');
  };
  function closeModals(){ document.querySelectorAll('.modal.open').forEach(m => m.classList.remove('open')); }
  document.querySelectorAll('.modal').forEach(m => m.addEventListener('click', ev => { if(ev.target === m) m.classList.remove('open'); }));
  const keysModal = document.getElementById('keysModal');
  function openKeys(){ closeMenu(); keysModal.classList.add('open'); }
  document.getElementById('keysBtn').onclick = openKeys;
  document.getElementById('helpBtn').onclick = openKeys;
  document.getElementById('closeKeys').onclick = () => keysModal.classList.remove('open');
  // the note rides the send marker, so the session reads it with the board
  const noteModal = document.getElementById('noteModal'), noteText = document.getElementById('noteText');
  function askClaude(){
    closeMenu();
    if(inflight || (pingBtn.disabled && !readOnly)){ toast('The board is already on its way.'); return; }
    if(pingBtn.disabled){ toast(pingBtn.title || 'Asking Claude is unavailable in this view.', 6000); return; }
    if(noteModal.classList.contains('open')) return;
    let kept = ''; try{ kept = sessionStorage.getItem(NOTE) || ''; }catch(_){}
    noteModal.classList.add('open'); noteText.value = kept; setTimeout(() => noteText.focus(), 0);
  }
  document.getElementById('noteCancel').onclick = () => { noteModal.classList.remove('open'); try{ sessionStorage.removeItem(NOTE); }catch(_){} };
  document.getElementById('noteSend').onclick = () => { const n = noteText.value; noteModal.classList.remove('open'); publishBoard(true, n); };
  noteText.addEventListener('keydown', ev => {
    if((ev.ctrlKey || ev.metaKey) && ev.key === 'Enter'){ ev.preventDefault(); document.getElementById('noteSend').click(); }
    if(ev.key === 'Escape'){ ev.preventDefault(); noteModal.classList.remove('open'); }
    ev.stopPropagation();
  });

  // ---------- toast ----------
  let toastTimer = null;
  function toast(msg, ms){
    const t = document.getElementById('toast');
    t.textContent = msg; t.classList.add('show');
    clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), ms || 2600);
  }

  // ---------- export ----------
  const modal = document.getElementById('exportModal');
  document.getElementById('exportBtn').onclick = () => { closeMenu(); exportPNG(); };
  const imageFile = document.getElementById('imageFile');
  document.getElementById('imageBtn').onclick = () => { closeMenu(); imageFile.value = ''; imageFile.click(); };
  imageFile.onchange = () => { if(imageFile.files[0]) insertImage(imageFile.files[0], null); };
  document.getElementById('pingBtn').onclick = sendToClaude;
  document.getElementById('submitBtn').onclick = () => { closeMenu(); submitBoard(); };
  document.getElementById('closeExport').onclick = () => modal.classList.remove('open');
  // the root's data-theme observer re-reads the tokens and repaints; the button only flips the stamp
  document.getElementById('themeBtn').onclick = () => setTheme(THEME_NEXT[rootTheme()]);

  async function exportPNG(){
    const b = boundsOfAll();
    if(!b){ toast('The board is empty — sketch something first.'); return; }
    const pad = 48, s = 2;
    const off = document.createElement('canvas');
    off.width = Math.ceil((b.w + pad * 2) * s); off.height = Math.ceil((b.h + pad * 2) * s);
    const oc = off.getContext('2d');
    oc.scale(s, s); oc.translate(pad - b.x, pad - b.y);
    oc.fillStyle = C.ground; oc.fillRect(b.x - pad, b.y - pad, b.w + pad * 2, b.h + pad * 2);
    for(const e of els) drawElement(oc, e);
    const blob = await new Promise(res => off.toBlob(res, 'image/png'));
    // the viewer runtime offers real file saves; the frame itself can't start downloads
    const dl = await cap('downloads');
    if(dl && blob){
      try{ await dl.save({filename: 'whiteboard.png', data: blob}); toast('Saved whiteboard.png'); return; }
      catch(err){ if(err && err.code === 'declined') return; }
    }
    if(navigator.clipboard && window.ClipboardItem && blob){
      try{ await navigator.clipboard.write([new ClipboardItem({'image/png': blob})]); toast('Board image copied — paste it wherever you like.'); return; }
      catch(_){}
    }
    // last resort: show the image so it can be right-clicked and saved
    document.getElementById('exportImg').src = off.toDataURL('image/png');
    modal.classList.add('open');
  }

  // ---------- tiny API for future integrations ----------
  window.whiteboard = {
    toJSON: () => clone(els),
    toPNG: () => exportPNG(),
    load: data => { mutate(() => { els = sanitize(clone(data)); selected.clear(); }); zoomFit(); }
  };

  // ---------- boot ----------
  applyStoredTheme(); // stamp the saved light/dark choice before the tokens are read, so the first paint matches
  readTheme();
  syncThemeBtn();
  if(!anchorLayer()) document.body.insertAdjacentHTML('afterbegin', anchorMarkup([]));
  loadState();
  loadSession();
  pruneSelection();
  setTool(tool);
  syncSnap();
  updateButtons();
  syncStatus();
  drawClawd(0);
  checkWaiting();
  try{ if(sessionStorage.getItem(LOST)){ sessionStorage.removeItem(LOST); toast('Your last Ask didn\u2019t go through \u2014 someone saved first. Ask Claude again' + (sessionStorage.getItem(NOTE) ? '; your note is kept.' : '.'), 7000); } }catch(_){}
  syncPresence();
  syncHold();
  primeSend();
  resize();
  // a load that lands on empty canvas jumps to the drawing; fresh orange marks come into view
  if(revealIds){ const fresh = els.filter(e => revealIds.indexOf(e.id) !== -1); if(nothingInView(fresh)) zoomFit(); revealIds = null; }
  else if(nothingInView(els)) zoomFit();
  joinRoom();
  joinStore();
  // the hand font arrives after first paint; re-measure every label once it is in
  if(document.fonts && document.fonts.ready) document.fonts.ready.then(() => { fitCache.clear(); textDims = new WeakMap(); render(); if(editing) fitEditor(); });
}

function boot(){
  const st = document.createElement('style'); st.textContent = CSS; document.head.appendChild(st);
  document.body.insertAdjacentHTML('beforeend', MARKUP);
  main();
}
themeMirror();
scheduleBoot();
</script>
<!-- The sheet sits AFTER the script so the template keeps the exact two-line head
     merge-state.mjs pins (<title>, <script>); scheduleBoot compensates by waiting for
     the parser to reach it before the canvas reads colors. -->
