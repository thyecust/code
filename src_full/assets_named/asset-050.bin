<title>Whiteboard</title>
<script>
"use strict";
const CSS = `
  /* The board's own vars resolve through the vendored @ant/cds token sheet (the static
     style element this page carries — artifacts render self-contained, so the sheet is
     embedded rather than injected). Canvas-read vars (--ground, --grid, --ink, --muted,
     --accent) must land on plain-hex ramp stops: getComputedStyle hands the canvas the
     substituted token TEXT, and ctx.fillStyle cannot evaluate the sheet's hsl(from ...)
     alpha tokens. CSS-only vars (--panel, --shadow) may use any token. Dark mode rides
     the sheet's own data-mode/OS axes (the script mirrors the viewer's data-theme stamp
     onto data-mode), so only board-owned vars need dark overrides here. */
  :root{
    color-scheme: light dark; /* counter the skeleton's :root{color-scheme:light} so UA chrome (scrollbars, caret, overscroll) follows the board's theme */
    --ground:var(--surface-0); --panel:var(--surface-2); --ink:var(--text-primary); --muted:var(--text-secondary);
    --grid:var(--gray-100); --accent:var(--text-accent); --shadow:var(--shadow-md);
    --claude:#c2410c; --sticky:#f4e187; --sticky-ink:#3b3320;
    --claude-sticky:#fdba74; --claude-sticky-ink:#231d0d;
    /* the viewer's stroke palette; orange stays Claude's alone, so it is not offered here */
    --s-red:#c92a2a; --s-green:#2b8a3e; --s-blue:#1864ab; --s-violet:#6741d9;
    --here:#2b8a3e; --hair:var(--gray-100);
    --ui:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    --hand:"Kalam","Segoe Print","Bradley Hand","Marker Felt","Comic Sans MS","Chalkboard SE",cursive;
  }
  /* Dark overrides for the board-owned values only — the CDS semantic tokens the vars
     above point at flip by themselves. Both axes, mirroring the vendored block's own
     structure: the media block's :where() keeps an explicit light stamp winning over
     OS-dark, and the attribute block forces dark on an OS-light machine. */
  @media (prefers-color-scheme: dark){
    :root:where(:not([data-mode="light"])){
      color-scheme: dark;
      --ground:var(--surface-1); /* dark: the board is the lower surface, chrome floats above it */
      --grid:var(--gray-700);
      --claude:#f0a24a; --sticky:#c9b25a; --sticky-ink:#231d0d;
      --claude-sticky:#f0a24a; --claude-sticky-ink:#231d0d;
      --s-red:#ff8787; --s-green:#69db7c; --s-blue:#74c0fc; --s-violet:#b197fc;
      --here:#69db7c; --hair:var(--gray-700);
    }
  }
  :root[data-mode="dark"]{
    color-scheme: dark;
    --ground:var(--surface-1); /* dark: the board is the lower surface, chrome floats above it */
    --grid:var(--gray-700);
    --claude:#f0a24a; --sticky:#c9b25a; --sticky-ink:#231d0d;
    --claude-sticky:#f0a24a; --claude-sticky-ink:#231d0d;
    --s-red:#ff8787; --s-green:#69db7c; --s-blue:#74c0fc; --s-violet:#b197fc;
    --here:#69db7c; --hair:var(--gray-700);
  }
  :root[data-mode="light"]{
    color-scheme: light;
    /* the paper colours restate their light defaults so every theme block carries
       the sticky palette; --ground/--grid need no restating — the :where() guard
       keeps both dark axes inert under a light stamp, so the base values win */
    --claude:#c2410c; --sticky:#f4e187; --sticky-ink:#3b3320;
    --claude-sticky:#fdba74; --claude-sticky-ink:#231d0d;
    --s-red:#c92a2a; --s-green:#2b8a3e; --s-blue:#1864ab; --s-violet:#6741d9;
    --here:#2b8a3e; --hair:var(--gray-100);
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{background:var(--ground);color:var(--ink);font:13px/1.4 var(--ui);overflow:hidden;-webkit-font-smoothing:antialiased}
  #board{position:fixed;inset:0;width:100%;height:100%;touch-action:none;display:block}
  #board.crosshair{cursor:crosshair}
  #board.grab{cursor:grab}
  #board.grabbing{cursor:grabbing}
  #board.move{cursor:move}
  #board.erase{cursor:cell}

  /* chrome floats on plain panels: hairline border, soft shadow, one radius */
  .panel{background:var(--panel);border:1px solid var(--hair);border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.08),0 4px 14px rgba(0,0,0,.06)}
  .btn{appearance:none;border:0;background:transparent;color:var(--ink);height:32px;min-width:32px;padding:0 9px;border-radius:7px;font:12px var(--ui);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:6px;position:relative}
  .btn:hover{background:var(--hair)}
  .btn:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
  .btn svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}
  .tb[aria-pressed="true"]{background:color-mix(in srgb,var(--fill-accent) 18%,transparent);color:var(--accent)}
  .btn.primary{background:var(--fill-accent);color:var(--on-accent);padding:0 14px;font-weight:600;height:36px;border-radius:9px}
  .btn.primary:hover{filter:brightness(1.08)}
  .btn:disabled{opacity:.4;cursor:default}
  .btn .key{position:absolute;right:3px;bottom:1px;font-size:8px;line-height:1;color:var(--muted);opacity:.8}
  .tb[aria-pressed="true"] .key{color:var(--accent)}
  .sep{background:var(--hair);flex:none}

  .toolbar{position:fixed;top:12px;left:50%;transform:translateX(-50%);display:flex;gap:2px;align-items:center;padding:4px;max-width:calc(100% - 400px);overflow-x:auto}
  .toolbar .sep{width:1px;height:20px;margin:0 3px}
  .menuBtn{position:fixed;top:12px;left:12px;padding:2px}
  .topright{position:fixed;top:12px;right:12px;display:flex;flex-direction:column;gap:6px;align-items:flex-end}
  .topright .chips{display:flex;flex-direction:column;gap:6px;align-items:flex-end}
  .menu{position:fixed;top:52px;left:12px;min-width:220px;padding:6px;display:none;flex-direction:column;z-index:5}
  .menu.open{display:flex}
  .menu .btn{justify-content:flex-start;height:30px;padding:0 8px;font-size:12.5px}
  .menu .btn .hint{margin-left:auto;color:var(--muted);font-size:11px}
  .menu hr{border:0;border-top:1px solid var(--hair);margin:5px 2px}
  #themeBtn svg{display:none}
  #themeBtn[data-choice="auto"] .t-auto,#themeBtn[data-choice="light"] .t-light,#themeBtn[data-choice="dark"] .t-dark{display:block}

  /* the properties card: stroke, fill, edge, text size */
  .stylebar{position:fixed;left:12px;top:50%;transform:translateY(-50%);width:172px;padding:10px 12px;display:flex;flex-direction:column;gap:10px}
  .stylebar[hidden]{display:none}
  .stylebar h3{margin:0 0 5px;font:11px var(--ui);color:var(--muted);font-weight:500}
  .stylebar .row{display:flex;gap:4px;flex-wrap:wrap}
  .sw{appearance:none;width:24px;height:24px;border-radius:6px;border:1px solid var(--hair);cursor:pointer;padding:0;background:var(--c)}
  .sw[aria-pressed="true"]{outline:2px solid var(--accent);outline-offset:1px}
  .sw.claude{display:none}
  .stylebar[data-claude="1"] .sw.claude{display:block}
  .stylebar[data-claude="1"] .sw[data-stroke]{opacity:.28;pointer-events:none;outline:0}
  .opt{appearance:none;width:32px;height:28px;border-radius:6px;border:1px solid var(--hair);background:transparent;color:var(--ink);cursor:pointer;display:grid;place-items:center;padding:0}
  .opt svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round}
  .opt[aria-pressed="true"]{background:var(--hair);border-color:var(--accent)}
  .opt:disabled{opacity:.35;cursor:default}
  .sizer{display:flex;align-items:center;gap:2px}
  .sizer .btn{height:28px;min-width:28px;padding:0 6px;border:1px solid var(--hair)}
  .sizer .zval{min-width:30px;text-align:center;font-variant-numeric:tabular-nums;color:var(--muted);font-size:12px}

  .zoombar{position:fixed;left:12px;bottom:12px;display:flex;gap:0;align-items:center;padding:2px}
  .zoombar .btn{height:28px;min-width:28px;padding:0 6px}
  .zoombar .zval{min-width:50px;height:28px;font-variant-numeric:tabular-nums;color:var(--ink);font-size:12px}
  .histbar{position:fixed;left:128px;bottom:12px;display:flex;gap:0;padding:2px}
  .histbar .btn{height:28px;min-width:30px;padding:0 6px}
  .helpBtn{position:fixed;right:12px;bottom:12px;padding:2px}
  .helpBtn .btn{font-weight:700;font-size:14px}

  @media (max-width: 760px){
    .toolbar{top:56px;max-width:calc(100% - 24px)}
    .topright .chips{position:fixed;top:100px;right:12px}
    .stylebar,.stylebar:not([hidden]){display:none}
  }
  #wb-anchors{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:0}
  .wb-a{position:absolute;display:block;pointer-events:none}
  .ctx{position:fixed;min-width:160px;padding:5px;display:none;flex-direction:column;z-index:6}
  .ctx.open{display:flex}
  .ctx .btn{justify-content:flex-start;height:30px;padding:0 8px;font-size:12.5px}
  .ctx .btn .hint{margin-left:auto;color:var(--muted);font-size:11px}
  .chip{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:12px;font-size:11px;color:var(--muted);white-space:nowrap}
  .chip.toggle{border:0;cursor:pointer;font:inherit;font-size:11px}
  .chip.toggle i{width:22px;height:12px;border-radius:6px;background:var(--hair);position:relative;transition:background .15s}
  .chip.toggle i::after{content:"";position:absolute;top:2px;left:2px;width:8px;height:8px;border-radius:50%;background:var(--panel);transition:left .15s}
  .chip.toggle[aria-pressed="true"] i{background:var(--claude)}
  .chip.toggle[aria-pressed="true"] i::after{left:12px}
  .chip i{width:7px;height:7px;border-radius:50%;background:var(--grid);display:inline-block;flex:none}
  .sync[data-s="saving"] i{background:var(--accent)}
  .sync[data-s="local"] i{background:var(--sticky)}
  .presence[hidden]{display:none}
  .presence[data-s="here"] i{background:var(--here);box-shadow:0 0 0 3px color-mix(in srgb,var(--here) 25%,transparent)}
  .presence[data-s="away"] i{background:transparent;border:1.5px solid var(--muted);width:8px;height:8px}
  .presence .others{color:var(--muted)}
  .presence .others:empty{display:none}

  .painter{position:fixed;top:90px;right:18px;display:flex;flex-direction:column;align-items:center;gap:1px;pointer-events:none;color:var(--muted);font-size:11px;max-width:180px;text-align:center}
  @media (max-width: 760px){ .painter{top:134px} }
  .painter[hidden]{display:none}
  .painter canvas{width:40px;height:35px;image-rendering:pixelated}
  .painter[data-live="1"] canvas{animation:hover 2.6s ease-in-out infinite}
  @keyframes hover{50%{transform:translateY(-4px)}}
  @media (prefers-reduced-motion: reduce){ .painter[data-live="1"] canvas{animation:none} }
  #editor::selection{background:color-mix(in srgb,var(--accent) 30%,transparent);color:transparent}
  #editor{position:fixed;display:none;resize:none;transform-origin:0 0;background:transparent;color:var(--ink);border:1.5px dashed var(--accent);outline:none;padding:2px 4px;font-family:var(--hand);white-space:pre;overflow:hidden;text-align:center;border-radius:4px}

  .toast{position:fixed;left:50%;bottom:64px;transform:translateX(-50%);background:#1e1e2e;color:#f3f3f1;padding:8px 14px;border-radius:9px;font-size:12.5px;opacity:0;transition:opacity .18s ease;pointer-events:none;max-width:min(520px,calc(100% - 40px));text-align:center}
  .toast.show{opacity:1}

  .modal{position:fixed;inset:0;background:rgba(11,11,11,.45);display:none;place-items:center;padding:24px;z-index:10}
  .modal.open{display:grid}
  .modal .card{color:var(--ink);padding:16px;max-width:min(920px,100%);max-height:100%;display:flex;flex-direction:column;gap:10px}
  .modal .card header{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .modal .card header h2{margin:0;font:600 14px var(--ui)}
  .modal .card .imgwrap{overflow:auto;border:1px solid var(--hair);border-radius:6px;background:var(--ground)}
  .modal .card img{display:block;max-width:100%;height:auto}
  .modal .card p{margin:0;color:var(--muted);font-size:12px}
  .modal textarea{width:min(440px,80vw);min-height:84px;resize:vertical;font:14px/1.4 var(--ui);color:var(--ink);background:var(--ground);border:1px solid var(--hair);border-radius:8px;padding:8px;outline:none}
  .modal textarea:focus{border-color:var(--accent)}
  .modal .actions{display:flex;justify-content:flex-end;gap:8px}
  .keys{display:grid;grid-template-columns:auto 1fr;gap:6px 18px;font-size:12.5px;margin:0;min-width:min(420px,80vw)}
  .keys dt{color:var(--muted);white-space:nowrap}
  .keys dd{margin:0}
  kbd{font:11px/1 var(--ui);border:1px solid var(--hair);border-bottom-width:2px;border-radius:4px;padding:2px 5px;color:var(--ink);background:var(--panel)}

  @media (prefers-reduced-motion: reduce){ .toast{transition:none} }
`;

const MARKUP = `
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kalam:wght@400&amp;display=swap">
<canvas id="board" class="crosshair" aria-label="Whiteboard canvas"></canvas>
<div class="panel menuBtn"><button class="btn" id="menuBtn" title="Menu" aria-haspopup="true" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M5 7h14M5 12h14M5 17h14"/></svg></button></div>
<div class="panel menu" id="menu" role="menu">
  <button class="btn" id="themeBtn" data-choice="auto" role="menuitem"><svg class="t-auto" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7.5"/><path d="M12 4.5a7.5 7.5 0 0 1 0 15z" fill="currentColor"/></svg><svg class="t-light" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8"/></svg><svg class="t-dark" viewBox="0 0 24 24"><path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5z"/></svg><span id="themeLabel">Theme</span></button>
  <button class="btn" id="snapBtn" aria-pressed="true" role="menuitemcheckbox"><svg viewBox="0 0 24 24"><path d="M4 4h4v4H4zM16 4h4v4h-4zM4 16h4v4H4zM16 16h4v4h-4z"/></svg>Snap to grid<span class="hint" id="snapHint">on</span></button>
  <button class="btn" id="zoomFit" role="menuitem"><svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>Zoom to fit<span class="hint">Shift+1</span></button>
  <hr>
  <button class="btn" id="imageBtn" role="menuitem"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M4 17l5-5 4 4 3-3 4 4"/></svg>Insert image&#8230;</button>
  <input type="file" id="imageFile" accept="image/*" hidden>
  <button class="btn" id="exportBtn" role="menuitem"><svg viewBox="0 0 24 24"><path d="M12 4v11"/><path d="M8 11l4 4 4-4"/><path d="M5 19h14"/></svg>Save as image</button>
  <button class="btn" id="submitBtn" role="menuitem" title="Save this board for everyone who has it open &#8212; doesn&#39;t ask Claude"><svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>Save for everyone<span class="hint">no ping</span></button>
  <hr>
  <button class="btn" id="clearBtn" role="menuitem"><svg viewBox="0 0 24 24"><path d="M5 7h14M9 7V4h6v3M7 7l1 13h8l1-13"/></svg>Clear board</button>
  <button class="btn" id="keysBtn" role="menuitem"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10"/></svg>Keyboard shortcuts<span class="hint">?</span></button>
</div>
<div class="panel toolbar" role="toolbar" aria-label="Drawing tools">
  <button class="btn tb" data-tool="hand" aria-pressed="false" title="Hand &#8212; drag to pan (H)"><svg viewBox="0 0 24 24"><path d="M7 11V6a1.5 1.5 0 0 1 3 0v5M10 11V4.5a1.5 1.5 0 0 1 3 0V11M13 11V5.5a1.5 1.5 0 0 1 3 0V11M16 11V8a1.5 1.5 0 0 1 3 0v6c0 3.5-2.5 6-6 6h-1c-2.5 0-4-1-5.5-3L4 13.5a1.5 1.5 0 0 1 2.4-1.8L7 12.5"/></svg><span class="key">H</span></button>
  <button class="btn tb" data-tool="select" aria-pressed="false" title="Select and move (V or 1)"><svg viewBox="0 0 24 24"><path d="M6 3l12 9-5.5 1.5L11 20 6 3z"/></svg><span class="key">1</span></button>
  <div class="sep"></div>
  <button class="btn tb" data-tool="rect" aria-pressed="true" title="Box / service (R or 2)"><svg viewBox="0 0 24 24"><rect x="4" y="6" width="16" height="12" rx="3"/></svg><span class="key">2</span></button>
  <button class="btn tb" data-tool="diamond" aria-pressed="false" title="Decision (Y or 3)"><svg viewBox="0 0 24 24"><path d="M12 4l8 8-8 8-8-8z"/></svg><span class="key">3</span></button>
  <button class="btn tb" data-tool="ellipse" aria-pressed="false" title="Ellipse (O or 4)"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="8" ry="6"/></svg><span class="key">4</span></button>
  <button class="btn tb" data-tool="cylinder" aria-pressed="false" title="Database (D)"><svg viewBox="0 0 24 24"><path d="M5 7c0-2 14-2 14 0v10c0 2-14 2-14 0z"/><path d="M5 7c0 2 14 2 14 0"/></svg><span class="key">D</span></button>
  <button class="btn tb" data-tool="sticky" aria-pressed="false" title="Sticky note (S)"><svg viewBox="0 0 24 24"><path d="M5 5h14v10l-4 4H5z"/><path d="M15 19v-4h4"/></svg><span class="key">S</span></button>
  <div class="sep"></div>
  <button class="btn tb" data-tool="arrow" aria-pressed="false" title="Arrow / connection (A or 5)"><svg viewBox="0 0 24 24"><path d="M5 19L19 5"/><path d="M11 5h8v8"/></svg><span class="key">5</span></button>
  <button class="btn tb" data-tool="line" aria-pressed="false" title="Line (L or 6)"><svg viewBox="0 0 24 24"><path d="M5 19L19 5"/></svg><span class="key">6</span></button>
  <button class="btn tb" data-tool="pen" aria-pressed="false" title="Draw (P or 7)"><svg viewBox="0 0 24 24"><path d="M4 20l4-1L19 8l-3-3L5 16z"/><path d="M14 6l3 3"/></svg><span class="key">7</span></button>
  <button class="btn tb" data-tool="text" aria-pressed="false" title="Text (T or 8)"><svg viewBox="0 0 24 24"><path d="M5 7V5h14v2"/><path d="M12 5v14"/><path d="M9 19h6"/></svg><span class="key">8</span></button>
  <div class="sep"></div>
  <button class="btn tb" data-tool="eraser" aria-pressed="false" title="Eraser (E or 0)"><svg viewBox="0 0 24 24"><path d="M20 20H9l-4.5-4.5a2 2 0 0 1 0-2.8L13 4.2a2 2 0 0 1 2.8 0l4 4a2 2 0 0 1 0 2.8L11 20"/><path d="M9 8l7 7"/></svg><span class="key">0</span></button>
</div>
<div class="topright" role="group" aria-label="Board actions">
  <button class="btn primary" id="pingBtn" title="Ask Claude to answer on the board (Ctrl+Enter)"><svg viewBox="0 0 24 24"><path d="M4 20l16-8L4 4l3 8z"/><path d="M7 12h13"/></svg>Ask Claude</button>
  <div class="chips">
    <button class="panel chip toggle" id="holdBtn" type="button" aria-pressed="true" aria-label="Let Claude jump in" title="Claude may draw on the board without being asked. Click to have it wait for Ask Claude."><i></i><span id="holdText">Claude may jump in</span></button>
    <span class="panel chip presence" id="presence" hidden><i></i><span id="presenceText">Claude</span><span class="others" id="othersText"></span></span>
    <span class="panel chip sync" id="sync" data-s="idle" title=""><i></i><span id="syncText">saved</span></span>
  </div>
</div>
<div class="panel stylebar" id="stylebar" aria-label="Style">
  <div><h3>Stroke</h3><div class="row" id="strokeRow">
    <button class="sw" data-stroke="ink" aria-pressed="true" title="Ink" style="--c:var(--ink)"></button>
    <button class="sw" data-stroke="red" aria-pressed="false" title="Red" style="--c:var(--s-red)"></button>
    <button class="sw" data-stroke="green" aria-pressed="false" title="Green" style="--c:var(--s-green)"></button>
    <button class="sw" data-stroke="blue" aria-pressed="false" title="Blue" style="--c:var(--s-blue)"></button>
    <button class="sw" data-stroke="violet" aria-pressed="false" title="Violet" style="--c:var(--s-violet)"></button>
    <button class="sw claude" aria-pressed="true" disabled title="Claude draws in orange &#8212; its marks keep that colour" style="--c:var(--claude)"></button>
  </div></div>
  <div><h3>Fill</h3><div class="row" id="fillRow">
    <button class="opt" data-fill="none" aria-pressed="true" title="No fill"><svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2"/></svg></button>
    <button class="opt" data-fill="hachure" aria-pressed="false" title="Hachure"><svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M5 11l6-6M5 17l12-12M9 19l10-10M15 19l4-4"/></svg></button>
    <button class="opt" data-fill="solid" aria-pressed="false" title="Solid"><svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2" fill="currentColor" fill-opacity=".35"/></svg></button>
  </div></div>
  <div><h3>Edge</h3><div class="row" id="dashRow">
    <button class="opt" data-dash="0" aria-pressed="true" title="Solid line"><svg viewBox="0 0 24 24"><path d="M4 12h16"/></svg></button>
    <button class="opt" data-dash="1" aria-pressed="false" title="Dashed line"><svg viewBox="0 0 24 24"><path d="M4 12h4M10 12h4M16 12h4"/></svg></button>
  </div></div>
  <div><h3>Text size</h3><div class="sizer" id="sizer">
    <button class="btn" id="sizeDown" title="Smaller text ([)">&#8722;</button>
    <span class="zval" id="sizeVal">17</span>
    <button class="btn" id="sizeUp" title="Larger text (])">+</button>
  </div></div>
</div>
<div class="panel zoombar">
  <button class="btn" id="zoomOut" title="Zoom out">&#8722;</button>
  <button class="btn zval" id="zoomVal" title="Zoom to fit (Shift+1)">100%</button>
  <button class="btn" id="zoomIn" title="Zoom in">+</button>
</div>
<div class="panel histbar">
  <button class="btn" id="undoBtn" title="Undo (Ctrl+Z)" disabled><svg viewBox="0 0 24 24"><path d="M9 5L5 9l4 4"/><path d="M5 9h9a5 5 0 0 1 0 10h-2"/></svg></button>
  <button class="btn" id="redoBtn" title="Redo (Ctrl+Shift+Z)" disabled><svg viewBox="0 0 24 24"><path d="M15 5l4 4-4 4"/><path d="M19 9h-9a5 5 0 0 0 0 10h2"/></svg></button>
</div>
<div class="panel helpBtn"><button class="btn" id="helpBtn" title="Keyboard shortcuts (?)">?</button></div>
<div class="painter" id="painter" hidden aria-live="polite">
  <canvas id="clawd" width="16" height="14" aria-hidden="true"></canvas>
  <span id="painterText">Sent to Claude</span>
</div>
<textarea id="editor" spellcheck="false" aria-label="Label editor"></textarea>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<div class="modal" id="exportModal" role="dialog" aria-modal="true" aria-labelledby="exportTitle">
  <div class="panel card">
    <header>
      <h2 id="exportTitle">Board image</h2>
      <button class="btn" id="closeExport">Close</button>
    </header>
    <div class="imgwrap"><img id="exportImg" alt="Rendered whiteboard"></div>
    <p>This view can't hand the file over directly &#8212; right-click the image to save or copy it.</p>
  </div>
</div>
<div class="modal" id="noteModal" role="dialog" aria-modal="true" aria-labelledby="noteTitle">
  <div class="panel card">
    <header><h2 id="noteTitle">Ask Claude</h2></header>
    <textarea id="noteText" maxlength="500" placeholder="Optional: what should Claude look at or answer? (Ctrl+Enter sends)"></textarea>
    <div class="actions"><button class="btn" id="noteCancel">Cancel</button><button class="btn primary" id="noteSend">Ask Claude</button></div>
  </div>
</div>
<div class="panel ctx" id="ctx" role="menu">
  <button class="btn" id="ctxComment" role="menuitem"><svg viewBox="0 0 24 24"><path d="M5 5h14v10H9l-4 4z"/></svg>Comment<span class="hint">C</span></button>
  <button class="btn" id="ctxDup" role="menuitem"><svg viewBox="0 0 24 24"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M5 15V6a1 1 0 0 1 1-1h9"/></svg>Duplicate<span class="hint">Ctrl+D</span></button>
  <button class="btn" id="ctxDel" role="menuitem"><svg viewBox="0 0 24 24"><path d="M5 7h14M9 7V4h6v3M7 7l1 13h8l1-13"/></svg>Delete<span class="hint">Del</span></button>
</div>
<div class="modal" id="keysModal" role="dialog" aria-modal="true" aria-labelledby="keysTitle">
  <div class="panel card">
    <header><h2 id="keysTitle">Keyboard shortcuts</h2><button class="btn" id="closeKeys">Close</button></header>
    <dl class="keys">
      <dt><kbd>H</kbd> <kbd>1</kbd>&#8230;<kbd>8</kbd> <kbd>0</kbd></dt><dd>Hand, select, box, decision, ellipse, arrow, line, draw, text, eraser (<kbd>D</kbd> database, <kbd>S</kbd> sticky)</dd>
      <dt>Drag, then type</dt><dd>Draw the current shape and label it (<kbd>Enter</kbd> or double-click labels anything later)</dd>
      <dt><kbd>Shift</kbd>+click, box-drag</dt><dd>Multi-select</dd>
      <dt><kbd>Space</kbd>-drag, scroll</dt><dd>Pan</dd>
      <dt><kbd>Ctrl</kbd>+scroll, <kbd>Shift</kbd>+<kbd>1</kbd></dt><dd>Zoom, zoom to fit</dd>
      <dt><kbd>[</kbd> <kbd>]</kbd></dt><dd>Text size</dd>
      <dt><kbd>Ctrl</kbd>+<kbd>Z</kbd>, <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd></dt><dd>Undo, redo</dd>
      <dt><kbd>Ctrl</kbd>+<kbd>A</kbd>, <kbd>Delete</kbd></dt><dd>Select all, delete selection</dd>
      <dt><kbd>C</kbd> or right-click</dt><dd>Comment on the selected element</dd>
      <dt><kbd>Ctrl</kbd>+<kbd>Enter</kbd></dt><dd>Ask Claude &#8212; Claude answers on the board in orange</dd>
    </dl>
  </div>
</div>
`;

// escape every "<" so nothing a viewer types can close the JSON block or open a tag
function esc(s){ return JSON.stringify(s).replace(/</g, '\\u003c'); }
// the board keeps the name it was published with; re-escape the decoded title for the head
// (element content only — this does not escape single quotes, so never use it in attributes)
function escHtml(s){ return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
// The vendored CDS token sheet rides the page as a static style element (it contains
// backticks, so it cannot live inside the CSS template literal). Reading it back off the
// DOM is what lets buildPage re-emit it on every republish.
function cdsTokenCss(){
  const el = document.getElementById('cds-tokens');
  return (el && el.textContent) || '';
}
// Publish gate for the captured sheet: buildPage re-emits it raw, so an empty capture
// (sheet loss would bake into every later generation) or a "</" (would terminate the
// style element and truncate the republished page) must refuse the publish.
function tokenCssPublishable(tokenCss){
  // U+FFFD is the remaining parser-divergence signal: a NUL in the served bytes
  // reaches the DOM capture as U+FFFD (RAWTEXT tokenization replaces it), which
  // would fork the captured block from the drift-gated template bytes forever.
  // The END-marker check refuses a tail-truncated capture (a cut-off transfer
  // still boots, and its Send would bake the truncation into every generation).
  return !!tokenCss && tokenCss.indexOf('</') === -1 && tokenCss.indexOf('\uFFFD') === -1
    && tokenCss.indexOf('===== END vendored @ant/cds tokens =====') !== -1;
}
// Pure serializer — no DOM, no closure state — so the republish round-trip (the token
// block must survive publish → reload → publish byte-identically) is testable headless.
// The JSON block comes first so a reading session finds the board state without running JS.
// Every top-level function must appear in the emission list below — one left out survives
// generation 1 and breaks only when the republished page itself republishes.
// Parse-safety: the state-block HTML comment emitted below is the page's only
// comment-open/close pair, and it must close before either script-opener literal
// that follows — a comment-open left unclosed ahead of a script-opener puts the
// WHATWG script-data tokenizer into double-escaped state, where the real end tag
// stops terminating the element and browsers swallow the rest of the page into
// the script. Never introduce comment-open bytes into any serialized function
// (including JS comments — toString() emits them); whiteboardMpTokens.test.ts pins
// this with a three-state tokenizer scan against the indexOf terminator.
function buildPage(state, title, tokenCss){
  // The state block stays ahead of the ~26KB sheet and the code script so a
  // reading session's head-slice fetch still captures it whole; the sheet only
  // has to parse before boot() reads colors, which scheduleBoot guarantees.
  return '<!doctype html><html><head><meta charset="utf-8">'
    + '<title>' + escHtml(title) + '</title></head><body>'
    + '<!-- whiteboard state (boxes, labels, arrows, ping marker) is the JSON block below -->'
    + '<script type="application/json" id="wb-state">' + esc(state) + '<\/script>'
    + anchorMarkup(state.els)
    + '<style id="cds-tokens">' + tokenCss + '</style>'
    + '<script>"use strict";const CSS=' + esc(CSS) + ';const MARKUP=' + esc(MARKUP) + ';'
    + esc.toString() + ';' + escHtml.toString() + ';' + cdsTokenCss.toString() + ';'
    + tokenCssPublishable.toString() + ';'
    + anchorMarkup.toString() + ';' + buildPage.toString() + ';' + themeMirror.toString() + ';' + scheduleBoot.toString() + ';'
    + main.toString() + ';' + boot.toString() + ';themeMirror();scheduleBoot();'
    + '<\/script></body></html>';
}
// One empty, invisible element per board element, in the published body: comment threads
// anchor to DOM nodes, and these are the nodes -- the page lines each up over its shape.
// Ids are restricted to a plain token so nothing from the state reaches markup unescaped.
function anchorMarkup(els){
  const ok = /^[A-Za-z0-9_-]{1,40}$/;
  let out = '<div id="wb-anchors" aria-hidden="true">';
  for(const e of Array.isArray(els) ? els : []) if(e && typeof e.id === 'string' && ok.test(e.id)) out += '<i class="wb-a" id="wb-a-' + e.id + '"></i>';
  return out + '</div>';
}
// The viewer toggle stamps data-theme on the root element; the vendored CDS token block
// keys its toggle axis on data-mode (the CDS convention) and cannot be edited
// (provenance-tested byte-identical). Mirroring the attribute lets that block serve the
// viewer toggle with its own precedence rules — toggle beats OS in both directions.
function themeMirror(){
  const root = document.documentElement;
  const sync = () => {
    const t = root.getAttribute('data-theme');
    if(t) root.setAttribute('data-mode', t);
    else root.removeAttribute('data-mode');
  };
  sync();
  if(typeof MutationObserver !== 'undefined'){
    new MutationObserver(sync).observe(root, {attributes: true, attributeFilter: ['data-theme']});
  }
}
// The token style element sits after this script in the template, so boot must wait for
// the parser to reach it: the canvas reads its colors off the sheet at startup, and an
// immediate boot would read them before the sheet exists.
function scheduleBoot(){
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
}

function main(){
  // ---------- state ----------
  const GRID = 20;
  const CLICK_PX = 4; // a press that travels fewer screen px than this is a click, not a drag
  const board = document.getElementById('board');
  const ctx = board.getContext('2d');
  const editor = document.getElementById('editor');
  // the board rides inside the page as a JSON block so a session reading the artifact can lift
  // the boxes, labels and connections straight out without a browser
  let embedded = null, embeddedAt = 0, fromSession = false, pingCount = 0, lastPing = null;
  const publishedIds = new Set(); // ids this tab has seen in a published version or arriving from others: one that later goes missing from a version was deleted, not drawn here
  const publishedNow = new Set(); // what this version itself carries
  // whether the session should wait to be asked before drawing; off by default, rides every publish and the room
  let hold = false, publishedHold = false;
  try{
    const stateEl = document.querySelector('script#wb-state'); // the first script carrying the id: a later tag merging the id onto <body> cannot retarget it
    const raw = stateEl ? JSON.parse(stateEl.textContent) : (window.__WB_STATE__ || null);
    const data = Array.isArray(raw) ? {els: raw} : (raw || null);
    if(data && Array.isArray(data.els)) embedded = data.els;
    if(data && typeof data.savedAt === 'number') embeddedAt = data.savedAt;
    // only the session's write-back stamps builtAt: the version already reflects the store up to it, and its presence says who wrote this version
    if(data && typeof data.builtAt === 'number'){ fromSession = true; embeddedAt = Math.max(embeddedAt, data.builtAt); }
    if(data && data.hold === true) hold = publishedHold = true;
    if(embedded) for(const e of embedded) if(e && typeof e.id === 'string'){ publishedIds.add(e.id); publishedNow.add(e.id); }
    // pingCount is carried on every version so ping.n stays monotonic across sends
    // the send marker rides in viewer-writable state like every other field here, so bound it
    // the way sanitize() bounds the rest: an integer count and a short timestamp string
    const pingN = v => Number.isFinite(v) ? Math.max(0, Math.min(1e9, Math.floor(v))) : null;
    if(data && pingN(data.pingCount) !== null) pingCount = pingN(data.pingCount);
    else if(data && data.ping && pingN(data.ping.n) !== null) pingCount = pingN(data.ping.n);
    if(data && data.ping && pingN(data.ping.n) !== null)
      lastPing = {n: pingN(data.ping.n), at: typeof data.ping.at === 'string' ? data.ping.at.slice(0, 64) : null,
                  note: typeof data.ping.note === 'string' && data.ping.note ? data.ping.note.slice(0, 500) : undefined};
  }catch(_){}

  let els = [];
  let selected = new Set(); // ids of every selected element
  let tool = 'rect';
  // what the next shape is drawn with; picking a swatch also restyles the selection
  const STROKES = ['ink', 'red', 'green', 'blue', 'violet'];
  const FILLS = ['none', 'hachure', 'solid'];
  const IMG_SRC_RE = /^data:image\/(png|jpeg|webp|gif)\x3bbase64,[A-Za-z0-9+/=]+$/;
  const IMG_MAX_CHARS = 1400000;
  const IMG_MAX_TOTAL = 3500000; // with the rest of the board this stays inside what one localStorage entry holds (about 5M characters)
  let style = {stroke: 'ink', fill: 'none', dash: false};
  let glowIds = new Set(), glowUntil = 0; // Claude's fresh marks pulse for a moment after they land
  let revealIds = null; // fresh marks to bring into view once the canvas has a size
  let typeTarget = null; // the shape just drawn: typing goes straight into its label until anything else happens
  let snap = true;
  let view = {x: 0, y: 0, scale: 1};
  let undoStack = [], redoStack = [];
  let drag = null;
  let editing = null;
  let editAnchor = null, editScale = 1; // world-space origin + layout scale of the open editor
  let spaceHeld = false;
  let dpr = Math.max(1, window.devicePixelRatio || 1);
  let C = {};

  const uid = () => Math.random().toString(36).slice(2, 9);
  const clone = o => JSON.parse(JSON.stringify(o));
  const byClaude = e => e && (e.author === 'claude' || e.by === 'claude');
  // Claude's notes sit on orange paper, the user's on yellow; each paper carries its own readable ink
  const stickyPaper = e => byClaude(e) ? {fill: C.claudeSticky, ink: C.claudeStickyInk} : {fill: C.sticky, ink: C.stickyInk};
  // the one selected element, or null when the selection is empty or holds several
  const selOne = () => selected.size === 1 ? els.find(e => selected.has(e.id)) || null : null;

  // ---------- theme ----------
  function readTheme(){
    const cs = getComputedStyle(document.documentElement);
    const v = n => cs.getPropertyValue(n).trim();
    C = {ground: v('--ground'), grid: v('--grid'), ink: v('--ink'), muted: v('--muted'),
         accent: v('--accent'), claude: v('--claude'), sticky: v('--sticky'), stickyInk: v('--sticky-ink'),
         claudeSticky: v('--claude-sticky'), claudeStickyInk: v('--claude-sticky-ink'),
         red: v('--s-red'), green: v('--s-green'), blue: v('--s-blue'), violet: v('--s-violet'),
         hand: v('--hand'), ui: v('--ui')};
  }
  // Claude's strokes always read in orange marker, whatever stroke the element names
  const strokeColor = e => byClaude(e) ? C.claude : (C[e.stroke] || C.ink);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { readTheme(); render(); });
  new MutationObserver(() => { readTheme(); render(); syncThemeBtn(); })
    .observe(document.documentElement, {attributes: true, attributeFilter: ['data-theme']});

  // The root's data-theme stamp is the single source of truth: absent = follow the OS. The
  // button reads and cycles that stamp; localStorage only carries the choice across reloads.
  const THEME_KEY = 'wb-theme';
  const rootTheme = () => {
    const t = document.documentElement.getAttribute('data-theme');
    return t === 'light' || t === 'dark' ? t : 'auto';
  };
  function setTheme(t){
    if(t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    else document.documentElement.removeAttribute('data-theme');
    try{ t === 'auto' ? localStorage.removeItem(THEME_KEY) : localStorage.setItem(THEME_KEY, t); }catch(_){}
  }
  const THEME_NEXT = {auto: 'light', light: 'dark', dark: 'auto'};
  const THEME_TITLE = {auto: 'Theme: follows your system — click for light', light: 'Theme: light — click for dark', dark: 'Theme: dark — click to follow your system'};
  const THEME_LABEL = {auto: 'Theme: system', light: 'Theme: light', dark: 'Theme: dark'};
  function syncThemeBtn(){
    const b = document.getElementById('themeBtn'); if(!b) return;
    const t = rootTheme();
    b.title = THEME_TITLE[t]; b.setAttribute('aria-label', THEME_TITLE[t]); b.dataset.choice = t;
    const l = document.getElementById('themeLabel'); if(l) l.textContent = THEME_LABEL[t];
  }
  // a saved choice never overrides a stamp the host already set on the root
  const applyStoredTheme = () => {
    if(document.documentElement.hasAttribute('data-theme')) return;
    try{ const t = localStorage.getItem(THEME_KEY); if(t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); }catch(_){}
  };

  // ---------- persistence & self-publish ----------
  // Every edit is kept on this device (localStorage) and, when the board has them, shared as it happens
  // through the room and the artifact's store; the artifact itself is republished only by "Ask Claude"
  // or "Save for everyone", which bake the board in (Ask also stamps a ping marker). That reload is
  // deliberate, and pan/zoom, tool, selection and undo ride across it in sessionStorage.
  const KEY = 'wb-v0', SESSION = 'wb-session';
  const tomb = new Map(); // id -> when it was deleted; a newer edit of the same id brings it back
  const remote = new Map(); // id -> {el, dead, born, at}: the latest edit others made to each element since this tab opened, so undo replays only your own steps
  let seq = 0; // orders those arrivals against this tab's history steps; a counter, so no clock is involved
  const MAX_ELS = 2000, COORD_MAX = 1e6, SIZE_MAX = 1e4;
  // a 0.2.x runtime hands each capability to claude.use(name), null when this view can't run it;
  // a 0.1.x runtime has no use() and mounts them on window.claude synchronously
  const cap = async (name) => {
    const c = window.claude;
    if(!c) return null;
    return (typeof c.use === 'function' ? await c.use(name) : c[name]) || null;
  };
  const selfCap = async () => {
    const c = window.claude;
    if(!c) return null;
    return (typeof c.use === 'function' ? await c.use('artifact') : (c.artifact || c.self)) || null;
  };
  // the permission name for republishing; only a 0.1.x runtime from before the rename says 'self'
  const selfName = () => {
    const c = window.claude;
    return c && (typeof c.use === 'function' || c.artifact) ? 'artifact' : 'self';
  };
  // One-way send marker: first-party template code posts the capability envelope
  // itself (no runtime-API surface grows for it); the shell relays allowlisted
  // names to the server-side count and everything else drops silently.
  // The name must also exist in the shell broker's and the control
  // plane's page-event allowlists, or the relay drops it.
  const noteSend = () => {
    try { parent.postMessage({__frame_cap: true, cap: 'analytics', id: 'wb-send-' + Date.now(), method: 'track', args: ['frame_whiteboard_send']}, '*'); } catch (e) {}
  };
  let readOnly = false, inflight = false, unsent = false, blockedChip = '';
  const pingBtn = document.getElementById('pingBtn'), submitBtn = document.getElementById('submitBtn');
  const sync = document.getElementById('sync'), syncText = document.getElementById('syncText');
  function setSync(s, txt){ sync.dataset.s = s; syncText.textContent = txt; }

  let localFull = false; // the browser refused the last save: the chip says so and one toast explains it
  function saveLocal(){
    // deletions ride along as tombstones so a reload cannot repaint what was removed but not yet sent
    try{
      localStorage.setItem(KEY, JSON.stringify({els, view, at: Date.now(), unsent, hold, tomb: [...tomb.entries()].filter(p => p[1] > embeddedAt).slice(-500), pub: [...publishedIds].slice(-4000)}));
      localFull = false;
    }catch(_){
      if(!localFull){ localFull = true; toast(readOnly ? 'This browser can\u2019t hold the board any more.' : 'This browser can\u2019t hold the board any more \u2014 Save for everyone (or Ask Claude) to keep your work.', 7000); }
    }
  }
  // whatever wrote the block (a viewer, or a session republishing), normalize it into shapes the
  // renderer expects: known types, finite numbers, plain strings — nothing here reaches the DOM as HTML
  function sanitize(list, keepBindings){
    // coordinates and sizes are bounded so one element cannot make a fill loop run away
    const num = v => Number.isFinite(v) ? Math.max(-COORD_MAX, Math.min(COORD_MAX, v)) : 0;
    const dim = v => Math.min(SIZE_MAX, Math.abs(num(v)));
    const str = v => (typeof v === 'string' ? v : '').slice(0, 2000);
    const size = v => Number.isFinite(v) ? Math.max(8, Math.min(64, v)) : undefined;
    const out = [], seen = new Set(); // ids are unique on the board; a repeated id keeps its first kept element
    for(const e of Array.isArray(list) ? list.slice(0, MAX_ELS) : []){
      if(!e || typeof e !== 'object' || typeof e.id !== 'string') continue;
      const id = e.id.slice(0, 40);
      if(seen.has(id)) continue;
      const n = out.length, t = e.type, base = {id, type: t, seed: num(e.seed) || 1};
      if(e.author === 'claude' || e.by === 'claude') base.author = 'claude';
      // style rides as short enums; anything else falls back to plain ink, no fill, solid edge
      if(STROKES.indexOf(e.stroke) > 0) base.stroke = e.stroke;
      if(FILLS.indexOf(e.fill) > 0) base.fill = e.fill;
      if(e.dash === true) base.dash = true;
      if(Number.isFinite(e.mv)) base.mv = Math.min(e.mv, Date.now()); // last edit time, orders live merges; a stamp from a fast clock never outranks a later edit made here
      if(['rect','ellipse','cylinder','diamond','sticky'].includes(t)){
        // a shape is stored by its top-left corner with a non-negative size
        const x = num(e.x), y = num(e.y), w = num(e.w), h = num(e.h);
        out.push(Object.assign(base, {x: w < 0 ? num(x + w) : x, y: h < 0 ? num(y + h) : y, w: dim(w), h: dim(h), label: str(e.label)}));
      } else if(t === 'text'){
        const te = {x: num(e.x), y: num(e.y), text: str(e.text)};
        const sz = size(e.size);
        if(sz) te.size = sz;
        out.push(Object.assign(base, te));
      } else if(t === 'arrow' || t === 'line'){
        out.push(Object.assign(base, {x1: num(e.x1), y1: num(e.y1), x2: num(e.x2), y2: num(e.y2),
          label: str(e.label), fromId: typeof e.fromId === 'string' ? e.fromId.slice(0, 40) : null, toId: typeof e.toId === 'string' ? e.toId.slice(0, 40) : null}));
      } else if(t === 'image'){
        // a picture carried inline; only base64 image data is kept, sized to what the page inserts
        const src = typeof e.src === 'string' && e.src.length <= IMG_MAX_CHARS && IMG_SRC_RE.test(e.src) ? e.src : '';
        const x = num(e.x), y = num(e.y), w = dim(e.w) || 160, h = dim(e.h) || 120;
        out.push(Object.assign(base, {x, y, w, h, src, label: str(e.label)}));
      } else if(t === 'pen'){
        const pts = (Array.isArray(e.pts) ? e.pts : []).slice(0, 4000)
          .filter(p => Array.isArray(p) && Number.isFinite(p[0]) && Number.isFinite(p[1])).map(p => [num(p[0]), num(p[1])]);
        if(pts.length) out.push(Object.assign(base, {pts}));
      }
      if(out.length > n) seen.add(id);
    }
    // a whole board keeps only bindings that land on a connectable element; a partial batch (live ops)
    // keeps its bindings as sent, since the box may arrive in a later message - arrowEndpoints follows only connectables
    if(keepBindings) return out;
    const targets = new Set(out.filter(isConnectable).map(x => x.id));
    for(const a of out){
      if(a.type !== 'arrow' && a.type !== 'line') continue;
      if(!targets.has(a.fromId)) a.fromId = null;
      if(!targets.has(a.toId)) a.toId = null;
    }
    return out;
  }
  function loadState(){
    // Merge the local draft with the published version by id: an element both carry keeps its
    // newer edit (a tie goes to the version), what only one side has survives, and an unsent
    // delete newer than the page and newer than the element's last edit keeps it off.
    let local = null;
    try{ const raw = localStorage.getItem(KEY); if(raw) local = JSON.parse(raw); }catch(_){}
    if(local && Array.isArray(local.tomb)) for(const p of local.tomb) if(Array.isArray(p) && typeof p[0] === 'string' && Number.isFinite(p[1]) && p[1] > embeddedAt) tomb.set(p[0], Math.min(p[1], Date.now()));
    const localEls = local && Array.isArray(local.els) ? local.els : null;
    if(localEls && embedded){
      // The published version is authoritative for Claude's marks up to when it was built: one
      // missing from it and older than it was retired by Claude (an answered question) and must
      // not come back from a local copy; one newer than it was drawn live since and stays.
      const pub = embedded.filter(e => e && typeof e.id === 'string');
      const claudeLive = new Set(pub.filter(byClaude).map(e => e.id)), inPub = new Set(pub.map(e => e.id));
      const retired = e => byClaude(e) && !claudeLive.has(e.id) && !(Number.isFinite(e.mv) && e.mv > embeddedAt);
      // an element this tab once saw published, now absent from the version and not edited here since, was deleted by someone who saved
      const wasPub = new Set(Array.isArray(local.pub) ? local.pub.filter(x => typeof x === 'string').slice(0, 4000) : []);
      const gone = e => !inPub.has(e.id) && wasPub.has(e.id) && !(Number.isFinite(e.mv) && e.mv > embeddedAt);
      const localKept = localEls.filter(e => e && typeof e.id === 'string' && !retired(e) && !gone(e));
      const localNewer = local.at > embeddedAt;
      const mine = new Map(localKept.map(e => [e.id, e])), won = new Set();
      const same = (a, b) => JSON.stringify(sanitize([a], true)) === JSON.stringify(sanitize([b], true));
      els = pub.map(e => {
        const l = mine.get(e.id); mine.delete(e.id);
        if(l && (Number(l.mv) || 0) > (Number(e.mv) || 0)) return l;
        const c = clone(e);
        // the version brought or changed it (an identical copy is no news, and one your unsent delete removes is not an arrival)
        if((!l || (Number(l.mv) || 0) < (Number(e.mv) || 0) || !same(l, c)) && !(tomb.get(c.id) >= (Number(c.mv) || 0))) won.add(c.id);
        return c;
      }).concat([...mine.values()]);
      // a picture's bytes never cross the room, so whichever copy holds them keeps them: a placeholder cannot shadow the published image
      const bytes = new Map(pub.concat(localKept).filter(e => e.type === 'image' && e.src).map(e => [e.id, e.src]));
      for(const e of els) if(e && e.type === 'image' && !e.src && bytes.has(e.id)) e.src = bytes.get(e.id);
      if(localNewer && local.view && typeof local.view.scale === 'number') view = local.view;
      if(localNewer && typeof local.hold === 'boolean') hold = local.hold;
      unsent = !!local.unsent;
      // what the version changed against this tab's draft (its copy won, it brought an element, it retired a
      // mark) counts as everyone else's edit for the carried history: loadSession folds it into the steps
      const had = new Set(localEls.map(e => e && e.id));
      fromVersion = {won, ups: [], born: id => !had.has(id), dels: localEls.filter(e => e && typeof e.id === 'string' && (retired(e) || gone(e))).map(e => e.id)};
    } else if(localEls){
      els = localEls;
      if(local.view && typeof local.view.scale === 'number') view = local.view;
      if(typeof local.hold === 'boolean') hold = local.hold;
      unsent = !!local.unsent;
    } else if(embedded){
      els = clone(embedded);
    }
    els = sanitize(els).filter(e => !(tomb.has(e.id) && tomb.get(e.id) >= (e.mv || 0)));
    if(fromVersion) fromVersion.ups = els.filter(e => fromVersion.won.has(e.id)); // the copies as this tab now holds them (bounded, stamps clamped)
    keepBytes(els);
  }
  // the session copy is written a beat after the last change, so a pan or a burst of edits costs one write;
  // history is kept newest-first within what one sessionStorage entry holds
  const SESSION_MAX = 3500000;
  let sessionTimer = 0;
  function saveSession(){ clearTimeout(sessionTimer); sessionTimer = setTimeout(writeSession, 250); }
  function writeSession(){
    clearTimeout(sessionTimer);
    // a step is stored as a quoted string, so its escaped length is what it costs
    const fit = stack => { let n = 0, used = 0; while(n < stack.length){ const len = JSON.stringify(stack[stack.length - 1 - n].json).length; if(used + len > budget) break; used += len; n++; } budget -= used; return stack.slice(stack.length - n); };
    // what others did since this tab opened rides along, so history that survives a reload still knows it
    const base = {view, tool, snap, selectedIds: [...selected], textSize, style, seq, remote: [...remote.entries()], wrote: [...wrote.entries()].slice(-MAX_ELS)};
    let budget = SESSION_MAX - histJson(base).length;
    const u = fit(undoStack), r = fit(redoStack);
    try{ sessionStorage.setItem(SESSION, histJson(Object.assign(base, {undoStack: u, redoStack: r}))); }catch(_){}
  }
  window.addEventListener('pagehide', writeSession);
  let fromVersion = null;
  function loadSession(){
    try{
      const raw = sessionStorage.getItem(SESSION);
      const d = raw ? JSON.parse(raw) : null;
      if(!d || typeof d !== 'object') return;
      if(d.view && typeof d.view.scale === 'number') view = d.view;
      if(Number.isFinite(d.seq) && d.seq > 0) seq = Math.floor(d.seq);
      if(Array.isArray(d.wrote)) for(const p of d.wrote) if(Array.isArray(p) && typeof p[0] === 'string' && Number.isFinite(p[1])) wrote.set(p[0], p[1]);
      // edits others made before the reload, and what the loaded version itself changed, are folded into the
      // carried history once, here, in the order they happened; the map then starts empty again
      if(Array.isArray(d.remote)) for(const p of d.remote) if(Array.isArray(p) && typeof p[0] === 'string' && p[1] && typeof p[1] === 'object') remote.set(p[0], p[1]);
      if(fromVersion){
        const at = ++seq;
        // an element that first arrived from someone else stays theirs when the version re-delivers it changed
        for(const e of fromVersion.ups){ const r = remote.get(e.id); remote.set(e.id, {el: e.type === 'image' ? Object.assign({}, e) : clone(e), dead: undefined, born: fromVersion.born(e.id) || !!(r && r.born), at}); }
        for(const id of fromVersion.dels) remote.set(id, {el: null, dead: embeddedAt, born: false, at});
      }
      // an older page stored bare strings with no step order
      const carry = stack => stack.slice(-150).map(s => typeof s === 'string' ? {at: 0, json: s} : {at: Number(s && s.at) || 0, json: s && typeof s.json === 'string' ? s.json : '[]'})
        .map(s => { if(!remote.size) return s; try{ return {at: s.at, json: histJson(foldRemote(JSON.parse(s.json), s.at))}; }catch(_){ return s; } });
      if(Array.isArray(d.undoStack)) undoStack = carry(d.undoStack);
      if(Array.isArray(d.redoStack)) redoStack = carry(d.redoStack);
      remote.clear();
      if(typeof d.tool === 'string') tool = d.tool;
      if(typeof d.snap === 'boolean') snap = d.snap;
      selected = new Set(sessionSelectedIds(d));
      if(Number.isFinite(d.textSize)) textSize = Math.max(8, Math.min(64, d.textSize));
      if(d.style && typeof d.style === 'object') style = {stroke: STROKES.indexOf(d.style.stroke) > 0 ? d.style.stroke : 'ink', fill: FILLS.indexOf(d.style.fill) > 0 ? d.style.fill : 'none', dash: d.style.dash === true};
    }catch(_){}
    finally{ fromVersion = null; remote.clear(); }
  }
  // the session's selection, bounded like every other stored field; reads the single-id form
  // an older page wrote as well as the id list this one writes
  function sessionSelectedIds(d){
    if(d && Array.isArray(d.selectedIds)) return d.selectedIds.filter(x => typeof x === 'string').slice(0, 500);
    if(d && typeof d.selectedId === 'string') return [d.selectedId];
    return [];
  }
  // drop selected ids whose element is gone (an undo, merge or reload replaced the board)
  function pruneSelection(){
    if(!selected.size) return;
    const live = new Set(els.map(e => e.id));
    for(const id of [...selected]) if(!live.has(id)) selected.delete(id);
  }
  function goLocal(){ readOnly = true; saveLocal(); syncStatus(); }
  function syncStatus(){
    if(inflight){ setSync('saving', 'saving…'); return; }
    if(blockedChip){ setSync('local', blockedChip); return; } // the reason stays visible while Send is off
    // shared live (room or store up) is not yet saved in the artifact; with neither, edits wait in this browser
    const live = roomLive || !!elsCol;
    if(unsent && localFull) setSync('local', readOnly ? 'too big to keep on this device' : 'edits not saved \u2014 save for everyone');
    else if(unsent) setSync('local', readOnly ? 'saved on this device' : live ? 'not saved in the artifact yet' : 'edits not sent yet');
    else setSync('idle', 'up to date');
    sync.title = unsent && !readOnly ? (localFull ? 'This browser can\u2019t hold the board any more. Ask Claude (or Save for everyone) keeps your work.'
      : live ? 'Your changes reach everyone who has the board open. Save for everyone (or Ask Claude) keeps them in the artifact.'
      : 'Your changes are saved in this browser. Ask Claude (or Save for everyone) shares them.') : '';
  }
  // a 0.1.x runtime can attach window.claude a beat after this script (script-order skew), so
  // give it a few seconds before concluding the permissions module is absent; use() waits itself
  async function runtimeReady(){
    const up = () => window.claude && (typeof window.claude.use === 'function' || window.claude.permissions);
    for(let i = 0; i < 20 && !up(); i++) await new Promise(r => setTimeout(r, 250));
  }
  // verdicts that never change for this view: a live module's answers and publish() refusals;
  // lifecycle codes (capability_disabled / _removed: a stale or re-booted runtime) stay transient
  const PERMANENT = ['denied', 'unavailable', 'consent_required', 'not_writer', 'not_granted', 'not_declared'];
  // only a live module's resolved answer is a verdict; an absent module, a rejection, or a
  // transient code is 'unknown', which leaves Send live for publish() to judge
  async function sendAccess(){
    const c = window.claude;
    if(!c) return 'unknown';
    const viaUse = typeof c.use === 'function';
    let perms, s;
    try{ perms = viaUse ? await c.use('permissions') : c.permissions; }
    catch(_){ return 'unknown'; }
    if(!perms) return 'unknown';
    try{ s = await perms.state(selfName()); }
    catch(_){ return 'unknown'; }
    return (s === 'granted' || s === 'prompt' || PERMANENT.indexOf(s) !== -1) ? s : 'unknown';
  }
  // 'denied' / 'consent_required' are the viewer's own choice; not_granted / not_declared mean the
  // board itself lacks send access; the rest can't be fixed from here, so copy stays ownership-neutral.
  function blockedMessage(state){
    if(state === 'denied' || state === 'consent_required') return 'Sending is off for this visit. Your sketch saves on this device.';
    if(state === 'not_writer') return 'You can view this board but not send it. It belongs to someone else.';
    if(state === 'not_granted' || state === 'not_declared')
      return 'Ask Claude isn\'t available on this board. Your sketch still saves on this device. Ask Claude to republish the board to reconnect it.';
    return 'Ask Claude isn\'t available in this view. Your sketch still saves on this device.';
  }
  function disableSend(state){
    pingBtn.disabled = submitBtn.disabled = true;
    pingBtn.title = submitBtn.title = blockedMessage(state);
    blockedChip = (state === 'denied' || state === 'consent_required')
      ? 'Sharing is off this visit · saved on this device'
      : 'Sharing is unavailable here · saved on this device';
    if(window.console && console.warn) console.warn('whiteboard send blocked', state);
    goLocal();
    toast(pingBtn.title, 7000);
  }
  async function ensureGrant(){
    let s = await sendAccess();
    if(s === 'prompt'){
      try{ const n = selfName(); const r = await (await cap('permissions')).request([n]); s = (r && r[n]) || 'unknown'; }
      catch(err){ s = (err && err.code) || 'unknown'; }
      if(s !== 'granted' && PERMANENT.indexOf(s) === -1) s = 'unknown';
    }
    return s;
  }
  // settle the button once at load: an authoritative verdict disables Send up front, while
  // 'granted', 'prompt' (asked inside the click gesture), and 'unknown' leave it live
  async function primeSend(){
    await runtimeReady();
    const s = await sendAccess();
    if(PERMANENT.indexOf(s) !== -1) disableSend(s);
  }
  // every edit lands on this device and on the live layer; the artifact itself changes only on Save or Ask Claude
  function persist(){ unsent = true; saveLocal(); saveSession(); syncStatus(); }
  // Submit and Send both republish the shared artifact; only Send stamps the ping marker that
  // flags the board for this session (and puts up the waiting-for-Claude painter)
  async function publishBoard(toClaude, note){
    if(inflight || (pingBtn.disabled && !readOnly)) return; // in flight, or sent and about to reload: a second Ctrl+Enter is not a second send
    if(readOnly){ toast(pingBtn.title || 'This view can\'t write to the shared artifact, so it can\'t save there.', 7000); return; }
    if(!els.length){ toast('The board is empty — sketch something first.'); return; }
    if(editing) commitEdit();
    note = typeof note === 'string' ? note.trim().slice(0, 500) : '';
    inflight = true; pingBtn.disabled = submitBtn.disabled = true; syncStatus(); writeSession();
    const grant = await ensureGrant();
    // ensureGrant answers 'granted', 'unknown', or a PERMANENT verdict; 'unknown' leaves the
    // verdict to the publish itself
    if(grant !== 'granted' && grant !== 'unknown'){ settle(); disableSend(grant); return; }
    const api = await selfCap();
    if(!api){ settle(); syncStatus(); toast(blockedMessage('unavailable'), 7000); return; }
    const tokenCss = cdsTokenCss();
    if(!tokenCssPublishable(tokenCss)){
      // publishing without the sheet would bake the loss into every later generation
      settle(); syncStatus();
      toast('This view lost its design tokens — reload the board, then try again.');
      return;
    }
    const ping = toClaude ? {n: pingCount + 1, at: new Date().toISOString(), note: note || undefined} : null;
    // a save carries the last send's marker forward so an unanswered ping is never erased by a Submit
    const state = {v: 1, els: els, savedAt: Date.now(), pingCount: ping ? ping.n : pingCount, ping: ping || lastPing, hold: hold || undefined};
    // remember which of Claude's marks we've already seen so the reply can be spotted after reload
    if(toClaude) rememberWaiting(ping.n);
    api.publish(buildPage(state, document.title || 'Whiteboard', tokenCss)).then(() => {
      // the shell now reloads this view to the new version; the buttons stay down until it
      // does, so a second click in that gap cannot mint a duplicate send
      inflight = false; unsent = false; for(const e of els) publishedIds.add(e.id); saveLocal(); setTimeout(settle, 6000);
      // a session on the board hears the send once the new version is the record, so its read finds it;
      // a dropped moment costs nothing, the version is still there
      if(toClaude && room){ try{ room.emit('board.sent', {n: ping.n}).catch(() => {}); }catch(_){} }
      if(toClaude){ try{ sessionStorage.removeItem(NOTE); }catch(_){} }
      // the send count rides a one-way analytics envelope, not the publish API; a shell that predates it drops the message
      if(toClaude) noteSend();
      setSync('idle', toClaude ? 'sent to Claude' : 'saved for everyone'); // the shell reloads this view to the new version
      if(toClaude){ lastPing = ping; pingCount = ping.n; syncPainter(); }
    }).catch(err => {
      if(toClaude) clearWaiting();
      settle();
      const code = (err && err.code) || 'upstream_error';
      if(window.console && console.warn) console.warn('whiteboard publish rejected', code, err && err.message);
      if(code === 'conflict'){
        // a newer version won and this view reloads to it; an ask keeps its note for the next try
        if(toClaude){ try{ sessionStorage.setItem(LOST, '1'); if(note) sessionStorage.setItem(NOTE, note); }catch(_){} toast('Someone saved the board a moment before you \u2014 it\u2019s reloading. Ask Claude again once it has.', 7000); }
        return;
      }
      if(PERMANENT.indexOf(code) !== -1){ disableSend(code); return; }
      if(code === 'rate_limited'){ syncStatus(); toast('Saving too fast — give it a few seconds and try again.'); return; }
      syncStatus(); toast('Couldn\'t save to the shared board. The board is still saved here. Try again in a moment. (error: ' + code + ')');
    });
  }
  function settle(){ inflight = false; if(!readOnly) pingBtn.disabled = submitBtn.disabled = false; }
  // Ask Claude opens the note sheet; the board goes when it is confirmed there, note or not
  const sendToClaude = () => askClaude();
  const submitBoard = () => publishBoard(false);

  // ---------- who is on the board, and is Claude drawing back ----------
  // The room says who has the board open right now: other viewers, and the Claude session
  // that published it (an "agent" peer) while it is listening. After a send, Clawd waves the
  // brush only while that session is actually present; with the session away, or no room to
  // ask, the corner says the board was sent and nothing more. A version the session wrote for
  // this ask, or new Claude-authored marks (the shell reloads this view to it), ends the wait.
  const WAIT = 'wb-waiting', NOTE = 'wb-note', LOST = 'wb-ask-lost', WAIT_TIMEOUT_MS = 15 * 60 * 1000;
  const painterEl = document.getElementById('painter'), painterText = document.getElementById('painterText');
  const presenceEl = document.getElementById('presence'), presenceText = document.getElementById('presenceText'), othersText = document.getElementById('othersText');
  const holdBtn = document.getElementById('holdBtn'), holdText = document.getElementById('holdText');
  function syncHold(){
    holdBtn.setAttribute('aria-pressed', hold ? 'false' : 'true');
    holdText.textContent = hold ? 'Claude waits for Ask' : 'Claude may jump in';
    holdBtn.title = hold ? 'Claude only draws when you click Ask Claude. Click to let it jump in on its own.' : 'Claude may draw on the board without being asked. Click to have it wait for Ask Claude.';
  }
  holdBtn.onclick = () => {
    hold = !hold; syncHold(); saveLocal();
    // the session hears it now; the next send or save carries it for whoever reads the page later
    if(room){ try{ room.emit('board.hold', {on: hold}).catch(() => {}); }catch(_){} }
    unsent = true; syncStatus();
  };
  let room = null, roomLive = false, agentHere = false, others = 0, waiting = false;
  let agentActive = false; // the session has visibly picked the board up since the ask: a live mark of its own arrived
  const claudeIds = () => els.filter(byClaude).map(e => e.id);
  function rememberWaiting(n){
    waiting = true; agentActive = false;
    try{ sessionStorage.setItem(WAIT, JSON.stringify({since: Date.now(), n, known: claudeIds()})); }catch(_){}
  }
  function clearWaiting(){ waiting = false; agentActive = false; try{ sessionStorage.removeItem(WAIT); }catch(_){} syncPainter(); }
  let paintTimer = null, paintFrame = 0;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function syncPainter(){
    // being in the room says the session can hear; only a mark of its own since the ask says it is at work
    const live = waiting && roomLive && agentHere && agentActive;
    painterEl.hidden = !waiting;
    painterEl.dataset.live = live ? '1' : '';
    painterText.textContent = live ? 'Claude is drawing'
      : !roomLive ? 'Asked Claude' : agentHere ? 'Asked · Claude is on the board' : 'Asked · Claude isn’t on the board yet';
    clearInterval(paintTimer); paintTimer = null;
    if(waiting){ drawClawd(0); if(live && !reduceMotion) paintTimer = setInterval(() => { paintFrame ^= 1; drawClawd(paintFrame); }, 420); }
  }
  function syncPresence(){
    presenceEl.hidden = !roomLive;
    presenceEl.dataset.s = agentHere ? 'here' : 'away';
    presenceText.textContent = agentHere ? 'Claude is here' : 'Claude is away';
    othersText.textContent = others ? '· ' + others + (others === 1 ? ' other' : ' others') : '';
    presenceEl.title = agentHere ? 'The Claude session that owns this board is listening.' : 'The Claude session that owns this board isn’t connected right now. Send still works — it reads the board when it’s back.';
    syncPainter(); syncStatus();
  }
  function checkWaiting(){
    let w = null;
    try{ const raw = sessionStorage.getItem(WAIT); if(raw) w = JSON.parse(raw); }catch(_){}
    if(!w) return;
    const known = new Set(w.known || []), here = new Set(claudeIds());
    const fresh = [...here].filter(id => !known.has(id));
    // a reply is new orange marks, or a version the session's helper wrote that carries this ask (whatever it changed)
    const answered = fromSession && !(pingCount < w.n);
    if(fresh.length || answered){
      waiting = false; try{ sessionStorage.removeItem(WAIT); }catch(_){}
      if(fresh.length){ glowIds = new Set(fresh); glowUntil = Date.now() + 4000; revealIds = fresh; }
      toast(fresh.length === 1 ? 'Claude drew back on the board (in orange).' : fresh.length ? 'Claude drew back — ' + fresh.length + ' orange marks on the board.' : 'Claude updated the board.');
      syncPainter();
      return;
    }
    if(Date.now() - (w.since || 0) > WAIT_TIMEOUT_MS){ clearWaiting(); return; }
    waiting = true; syncPainter();
  }
  // ---------- live layer: everyone on the board sees edits and pointers as they happen ----------
  // The published version stays the record; the room only carries what has not been sent yet.
  // Edits travel as element upserts/deletes, newest edit per element wins (mv); a tab that
  // joins late is streamed the unsent scene by one of the tabs already here.
  let cursors = [], ghosts = new Map(), myPeer = null, viewerPeers = [], roomReadyAt = 0;
  let pageHidden = document.visibilityState === 'hidden';
  document.addEventListener('visibilitychange', () => { pageHidden = document.visibilityState === 'hidden'; });
  // ---------- store: edits since the newest published version, kept for whoever opens the board next ----------
  // The room is the instant path and forgets; the publish is the record and needs a click. In between,
  // every committed edit is also written to the artifact's store (one doc per element, newest edit wins,
  // a tombstone for a delete), and a tab that opens the board overlays whatever there is newer than the
  // version it was built from - so work survives everyone closing their tabs, and a late joiner needs
  // no one present to catch up. Docs older than the page are inert: the publish already speaks for them.
  let elsCol = null, storeStopped = '';
  const STORE_DOC_MAX = 240000;
  function storeWrite(ups, dels){
    if(!elsCol) return;
    for(const e of ups){
      let doc = e; // the whole element: the store's cap is its own, far above a room message's
      if(JSON.stringify(doc).length > STORE_DOC_MAX) doc = doc.type === 'image' ? Object.assign({}, doc, {src: ''}) : null; // bytes past a doc's cap wait for the publish
      if(doc) queueWrite(doc.id, doc);
    }
    for(const pair of dels) queueWrite(pair[0], {id: pair[0], dead: pair[1]});
  }
  // one write in flight at a time, coalesced per element: a drag that ends twice quickly stores its last state once
  let writeChain = Promise.resolve();
  const pendingWrites = new Map(), wrote = new Map(); // wrote: id -> the stamp this tab last stored, so its own doc coming back is not someone else's edit
  function queueWrite(id, body){
    const queued = pendingWrites.has(id); pendingWrites.set(id, body); if(queued) return;
    writeChain = writeChain.then(() => {
      const b = pendingWrites.get(id); pendingWrites.delete(id);
      if(!elsCol || !b) return null;
      wrote.set(id, Number.isFinite(b.dead) ? b.dead : b.mv);
      return elsCol.doc(id).set(b).catch(err => {
        const code = err && err.code;
        if(code === 'quota_exceeded' || code === 'revoked' || code === 'invalid_argument') stopStore(code);
      });
    });
  }
  function stopStore(code){
    if(!elsCol) return;
    elsCol = null; storeStopped = code; syncStatus();
    if(code === 'quota_exceeded') toast('This board\u2019s live storage is full \u2014 Ask Claude or Save for everyone still keeps your work.', 7000);
    askSync();
  }
  // a view that cannot read the store asks whoever is present for the unsent scene instead
  let storeSettled = false, storeHeard = false;
  function askSync(){
    if(storeSettled && !elsCol && !storeHeard && room && roomLive && myPeer){ try{ room.emit('sync', {want: myPeer, quiet: true}).catch(() => {}); }catch(_){} }
  }
  const streamedTo = new Map(); // peer -> when this tab last streamed it the scene: one ask cannot turn a tab into a rebroadcast loop
  function answerSync(peer){
    if(!myPeer || peer === myPeer || !(unsent || tomb.size) || viewerPeers.indexOf(peer) === -1) return;
    if(Date.now() - (streamedTo.get(peer) || 0) < 10000) return;
    if(viewerPeers.filter(id => id !== peer).sort()[0] !== myPeer) return;
    streamedTo.set(peer, Date.now());
    netSend('sync', els, [...tomb.entries()], [peer], true);
  }
  async function joinStore(){
    try{
      const s = await cap('db');
      if(!s || typeof s.collection !== 'function') return;
      try{ elsCol = s.collection('els'); }catch(_){ return; }
      watchStore();
    } finally { storeSettled = true; askSync(); }
  }
  function watchStore(){
    const since = embeddedAt;
